{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gewyvern.dev/schemas/project-status-tensor-v3.json",
  "title": "Gewyvern Project Status Tensor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "checkpoint", "calibration", "dimensions", "coverage_requirements", "cells"],
  "properties": {
    "schema_version": { "const": 3 },
    "project": { "type": "string", "minLength": 1 },
    "checkpoint": { "type": "string", "minLength": 1 },
    "calibration": { "$ref": "#/$defs/calibration" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectures", "modules", "features"],
      "properties": {
        "architectures": { "$ref": "#/$defs/dimension" },
        "modules": { "$ref": "#/$defs/dimension" },
        "features": { "$ref": "#/$defs/dimension" }
      }
    },
    "coverage_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverage_requirement" }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "as_of"],
      "properties": {
        "model": { "const": "priority-weighted-strength-v1" },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "dimension": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "architecture", "kind", "summary", "source", "cells"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "architecture": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["ownership-boundary", "roadmap-gate", "proof-shelf"] },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "architecture",
        "module",
        "feature",
        "lifecycle",
        "priority",
        "maturity",
        "completion",
        "confidence",
        "independence",
        "contract",
        "depends_on",
        "blockers",
        "consumers",
        "evidence",
        "next_gate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$"
        },
        "architecture": { "$ref": "#/$defs/identifier" },
        "module": { "$ref": "#/$defs/identifier" },
        "feature": { "$ref": "#/$defs/identifier" },
        "lifecycle": {
          "enum": ["current", "bridge", "target", "retired"]
        },
        "priority": {
          "enum": ["critical", "active", "maintenance", "deferred"]
        },
        "maturity": {
          "enum": [
            "planned",
            "incubating",
            "developing",
            "stabilizing",
            "mature",
            "deprecated",
            "blocked"
          ]
        },
        "completion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "enum": ["low", "medium", "high"]
        },
        "independence": {
          "enum": [
            "internal",
            "reusable-library",
            "standalone-tool",
            "standalone-service",
            "replaceable-frontend"
          ]
        },
        "contract": { "$ref": "#/$defs/contract" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "next_gate": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "stability", "surfaces"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1 },
        "stability": {
          "enum": ["draft", "evolving", "stable", "deprecated"]
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "state"],
      "properties": {
        "kind": {
          "enum": ["source", "test", "documentation", "benchmark", "release"]
        },
        "path": { "type": "string", "minLength": 1 },
        "state": { "enum": ["present", "planned"] }
      }
    }
  }
}
