<UserControl
    x:Class="Leserpent.Avalonia.VirtualizedItemView"
    x:DataType="local:VirtualizedItemViewModel"
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Leserpent.Avalonia">
  <ContentControl Content="{Binding Content}" />
</UserControl>
