<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(PublishAot)' != 'true'">$(MSBuildProjectDirectory)/packages.development.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">$(MSBuildProjectDirectory)/packages.lock.json</NuGetLockFilePath>
    <NativeAotToolchainVersion Condition="'$(NativeAotToolchainVersion)' == ''">10.0.9</NativeAotToolchainVersion>
    <RuntimeFrameworkVersion Condition="'$(PublishAot)' == 'true'">$(NativeAotToolchainVersion)</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch Condition="'$(PublishAot)' == 'true'">false</TargetLatestRuntimePatch>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../..'))</RepositoryRoot>
    <RustCompatibilityBridgePath>$(RepositoryRoot)/target/release/leserpent-compat-bridge</RustCompatibilityBridgePath>
    <LeserpentDaemonPath>$(RepositoryRoot)/target/release/leserpentd</LeserpentDaemonPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <KnownFrameworkReference Update="Microsoft.NETCore.App"
                             Condition="'$(TargetFramework)' == 'net10.0'"
                             LatestRuntimeFrameworkVersion="$(NativeAotToolchainVersion)"
                             TargetingPackVersion="$(NativeAotToolchainVersion)" />
    <KnownRuntimePack Update="Microsoft.NETCore.App"
                      Condition="'$(TargetFramework)' == 'net10.0'"
                      LatestRuntimeFrameworkVersion="$(NativeAotToolchainVersion)" />
    <KnownAppHostPack Update="Microsoft.NETCore.App"
                      Condition="'$(TargetFramework)' == 'net10.0'"
                      AppHostPackVersion="$(NativeAotToolchainVersion)" />
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler"
                         ILCompilerPackVersion="$(NativeAotToolchainVersion)" />
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks"
                     ILLinkPackVersion="$(NativeAotToolchainVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildRustCompatibilityBridge"
          BeforeTargets="Publish"
          Condition="('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64') And $([MSBuild]::IsOSPlatform('Linux'))">
    <Exec Command="cargo build --locked --release -p leserpent-protocol --bin leserpent-compat-bridge"
          WorkingDirectory="$(RepositoryRoot)" />
    <Exec Command="cargo build --locked --release -p leserpentd --bin leserpentd"
          WorkingDirectory="$(RepositoryRoot)" />
    <Copy SourceFiles="$(RustCompatibilityBridgePath)"
          DestinationFiles="$(PublishDir)leserpent-compat-bridge" />
    <Copy SourceFiles="$(LeserpentDaemonPath)"
          DestinationFiles="$(PublishDir)leserpentd" />
  </Target>

  <Target Name="RejectCrossPlatformRustCompatibilityBridge"
          BeforeTargets="Publish"
          Condition="('$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64') And !$([MSBuild]::IsOSPlatform('Linux'))">
    <Error Text="Leserpent Linux bundles, including the Rust compatibility bridge, must be published on Linux." />
  </Target>

</Project>
