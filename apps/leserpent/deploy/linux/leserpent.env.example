ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5210
LESERPENT_STATE_PATH=/var/lib/leserpent/control-plane-state.json
LESERPENT_DATABASE_PATH=/var/lib/leserpent/control-plane.db
LESERPENT_RUST_BRIDGE_BIN=/opt/leserpent/current/leserpent-compat-bridge
LESERPENT_RUST_BRIDGE_TIMEOUT_MS=2000
# Enable these together only after leserpentd has a private socket and configured Gewyvern targets.
# LESERPENT_DAEMON_SOCKET=/run/leserpent/leserpentd.sock
# LESERPENT_DAEMON_TOKEN=replace-with-the-same-private-32-byte-leserpentd-ipc-token
# LESERPENT_DAEMON_DEPLOY_TIMEOUT_MS=5000
LESERPENT_ALLOW_PUBLIC_ENDPOINTS=false
# LESERPENT_ADMIN_TOKEN is generated by install.sh on first installation.
