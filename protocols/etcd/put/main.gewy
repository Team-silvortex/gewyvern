# gewyvern stable-subset protocol path

fn etcd_put_rules() =
  let module_name = :etcd_put_path
  let put_narrative = "static:observed an etcd KV put request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :etcd_put
  |> reason_model :etcd_put_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_member
  |> program_rule pred: "packet_observed:tcp:remote:https:local_to_remote", stage: :packet_observed, narr: $put_narrative, dedupe: true, mod: $module_name, phase: :send_put
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_put
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_member
  |> reason_rule pred: "packet_observed:tcp:remote:https:local_to_remote", event: :packet_observed, narr: $put_narrative, dedupe: true, mod: $module_name, phase: :send_put
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_put

template :etcd_put_path
|> window :default_5s
|> use :etcd_put_rules
|> param :sock_lineage_fragment.capture_comm, true
