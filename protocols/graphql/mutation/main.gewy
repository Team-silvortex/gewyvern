# gewyvern stable-subset protocol path

fn graphql_mutation_rules() =
  let module_name = :graphql_mutation_path
  let mutation_narrative = "static:observed a GraphQL mutation-style HTTP POST request path"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:graphql_mutation)
  |> reason_model(:graphql_mutation_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_endpoint)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", stage: :packet_observed, narrative: ${mutation_narrative}, dedupe: true, module: ${module_name}, phase: :send_mutation)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_mutation_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_endpoint)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", key_event: :packet_observed, narrative: ${mutation_narrative}, dedupe: true, module: ${module_name}, phase: :send_mutation)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_mutation_response)

template(:graphql_mutation_path)
|> window(:default_5s)
|> use(:graphql_mutation_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
