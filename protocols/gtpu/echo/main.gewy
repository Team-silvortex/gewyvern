# gewyvern stable-subset protocol path

fn gtpu_echo_rules() =
  let module_name = :gtpu_echo_path
  let route_narrative = "static:program resolved an upstream route for this GTP-U echo path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :gtpu_echo
  |> reason_model :gtpu_echo_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:gtpu:local_to_remote:prefix2:0x3001", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_echo_request
  |> program_rule pred: "datagram_observed:udp:remote:gtpu:remote_to_local:prefix2:0x3002", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_echo_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:gtpu:local_to_remote:prefix2:0x3001", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_echo_request
  |> reason_rule pred: "datagram_observed:udp:remote:gtpu:remote_to_local:prefix2:0x3002", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_echo_response

template :gtpu_echo_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :gtpu_echo_rules
|> param :sock_lineage_fragment.capture_comm, true
