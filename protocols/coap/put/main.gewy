# gewyvern stable-subset protocol path

fn coap_put_rules() =
  let module_name = :coap_put_path
  let route_narrative = "static:program resolved an upstream route for this CoAP PUT path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :coap_put
  |> reason_model :coap_put_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:coap:local_to_remote:prefix2:0x4003", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_request
  |> program_rule pred: "datagram_observed:udp:remote:coap:remote_to_local:prefix2:0x6044", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_changed
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:coap:local_to_remote:prefix2:0x4003", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_request
  |> reason_rule pred: "datagram_observed:udp:remote:coap:remote_to_local:prefix2:0x6044", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_changed

template :coap_put_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :coap_put_rules
|> param :sock_lineage_fragment.capture_comm, true
