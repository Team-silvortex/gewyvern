fn coap_get_rules() = {
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :coap_get
  |> reason_model :coap_get_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: :coap_get_path, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: :coap_get_path, phase: :resolve_upstream
  |> program_rule pred: :datagram_observed:udp:remote:coap:local_to_remote:prefix2:0x4001, stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: :coap_get_path, phase: :send_request
  |> program_rule pred: :datagram_observed:udp:remote:coap:remote_to_local:prefix2:0x6045, stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: :coap_get_path, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: :coap_get_path, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: :coap_get_path, phase: :resolve_upstream
  |> reason_rule pred: :datagram_observed:udp:remote:coap:local_to_remote:prefix2:0x4001, event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: :coap_get_path, phase: :send_request
  |> reason_rule pred: :datagram_observed:udp:remote:coap:remote_to_local:prefix2:0x6045, event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: :coap_get_path, phase: :receive_response
}

template :coap_get_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :coap_get_rules
|> param :sock_lineage_fragment.capture_comm, true
