# gewyvern stable-subset protocol path

fn rtsp_play_rules() =
  let module_name = :rtsp_play_path
  let route_narrative = "static:program resolved an upstream route for this RTSP play session"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :rtsp_play
  |> reason_model :rtsp_play_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:rtsp", stage: :socket_state_transition, narr: "static:program initiated or advanced an RTSP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:rtsp:established", stage: :socket_state_transition, narr: "static:program reached an established RTSP socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x4f505449", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_options
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x50,0x75,0x62,0x6c", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_options_ok
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x44455343", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_describe
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x43,0x6f,0x6e,0x74", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_describe_ok
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x53455455", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_setup
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x53,0x65,0x73,0x73", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_setup_ok
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x504c4159", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_play
  |> program_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x52,0x61,0x6e,0x67", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_play_ok
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:rtsp", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:rtsp:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x4f505449", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_options
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x50,0x75,0x62,0x6c", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_options_ok
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x44455343", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_describe
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x43,0x6f,0x6e,0x74", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_describe_ok
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x53455455", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_setup
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x53,0x65,0x73,0x73", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_setup_ok
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:local_to_remote:prefix4:0x504c4159", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_play
  |> reason_rule pred: "packet_observed:tcp:remote:rtsp:remote_to_local:prefix4:0x52545350:bytes_at:9:0x32,0x30,0x30:bytes_at:17:0x52,0x61,0x6e,0x67", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_play_ok

template :rtsp_play_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :rtsp_play_rules
|> param :sock_lineage_fragment.capture_comm, true
