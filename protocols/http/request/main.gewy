fn http_request_rules() = {
  |> fragment(:tcp_state_fragment)
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:http_request)
  |> reason_model(:http_request_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: :http_request_path, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: :http_request_path, phase: :resolve_upstream)
  |> program_rule(predicate: :socket_state_observed:remote:https, stage: :socket_state_transition, narrative: :transport_socket_transition, dedupe: false, module: :http_request_path, phase: :connect)
  |> program_rule(predicate: :socket_state_observed:remote:https:established, stage: :socket_state_transition, narrative: :transport_socket_transition, dedupe: true, module: :http_request_path, phase: :establish)
  |> program_rule(predicate: :packet_observed:tcp:local_to_remote, stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: :http_request_path, phase: :send_request)
  |> program_rule(predicate: :packet_observed:tcp:remote_to_local, stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: :http_request_path, phase: :receive_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: :http_request_path, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: :http_request_path, phase: :resolve_upstream)
  |> reason_rule(predicate: :socket_state_observed:remote:https, key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: :http_request_path, phase: :connect)
  |> reason_rule(predicate: :socket_state_observed:remote:https:established, key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: :http_request_path, phase: :establish)
  |> reason_rule(predicate: :packet_observed:tcp:local_to_remote, key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: :http_request_path, phase: :send_request)
  |> reason_rule(predicate: :packet_observed:tcp:remote_to_local, key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: :http_request_path, phase: :receive_response)
}

template(:http_request_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:http_request_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
