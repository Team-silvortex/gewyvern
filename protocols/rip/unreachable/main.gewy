# gewyvern stable-subset protocol path

fn rip_unreachable_rules() =
  let module_name = :rip_unreachable_path
  let unreachable_narrative = "static:observed a RIP route update carrying unreachable metric 16"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :rip_unreachable
  |> reason_model :rip_unreachable_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_neighbor
  |> program_rule pred: "datagram_observed:udp:remote:rip:remote_to_local:byte_at:0:0xff:0x02:byte_at:1:0xff:0x02:byte_at:23:0xff:0x10", stage: :datagram_observed, narr: $unreachable_narrative, dedupe: true, mod: $module_name, phase: :receive_metric16
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_neighbor
  |> reason_rule pred: "datagram_observed:udp:remote:rip:remote_to_local:byte_at:0:0xff:0x02:byte_at:1:0xff:0x02:byte_at:23:0xff:0x10", event: :udp_datagram_seen, narr: $unreachable_narrative, dedupe: true, mod: $module_name, phase: :receive_metric16

template :rip_unreachable_path
|> window :default_5s
|> use :rip_unreachable_rules
|> param :sock_lineage_fragment.capture_comm, true
