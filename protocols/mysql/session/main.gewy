# gewyvern stable-subset protocol path

fn mysql_query_session_rules() =
  let module_name = :mysql_query_session
  let route_narrative = "static:program resolved an upstream route for this MySQL query session"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :mysql_query_session_model
  |> operation :mysql_query_session
  |> reason_model :mysql_query_session_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:mysql", stage: :socket_state_transition, narr: "static:program initiated or advanced a MySQL socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:mysql:established", stage: :socket_state_transition, narr: "static:program reached an established MySQL socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:mysql:local_to_remote:byte_at:4:0xff:0x03", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> program_rule pred: "packet_observed:tcp:remote:mysql:remote_to_local:byte_at:4:0xff:0x00", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ok
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:mysql", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:mysql:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:mysql:local_to_remote:byte_at:4:0xff:0x03", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> reason_rule pred: "packet_observed:tcp:remote:mysql:remote_to_local:byte_at:4:0xff:0x00", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ok

template :mysql_query_session
|> window :default_5s
|> use :mysql_query_session_rules
