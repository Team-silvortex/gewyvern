# gewyvern stable-subset protocol path

fn bgp_open_rules() =
  let module_name = :bgp_open_path
  let route_narrative = "static:program resolved a route before opening a BGP peer session"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> param(:tcp_packet_meta_fragment.sample_payload_offsets, 18)
  |> operation(:bgp_open)
  |> reason_model(:bgp_open_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: "socket_state_observed:remote:bgp", stage: :socket_state_transition, narrative: "static:program initiated or advanced a BGP socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "socket_state_observed:remote:bgp:established", stage: :socket_state_transition, narrative: "static:program reached an established BGP TCP session", dedupe: true, module: ${module_name}, phase: :establish)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> program_rule(predicate: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x01", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_open)
  |> program_rule(predicate: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x01", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_open)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: "socket_state_observed:remote:bgp", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "socket_state_observed:remote:bgp:established", key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: ${module_name}, phase: :establish)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> reason_rule(predicate: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x01", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_open)
  |> reason_rule(predicate: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x01", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_open)

template(:bgp_open_path)
|> window(:default_5s)
|> use(:bgp_open_rules)
