# gewyvern stable-subset protocol path

fn cassandra_startup_rules() =
  let module_name = :cassandra_startup_path
  let startup_narrative = "static:observed a Cassandra native protocol STARTUP frame"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :cassandra_startup
  |> reason_model :cassandra_startup_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> program_rule pred: "socket_state_observed:remote:9042", stage: :socket_state_transition, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:9042:local_to_remote:byte_at:4:0xff:0x01", stage: :packet_observed, narr: $startup_narrative, dedupe: true, mod: $module_name, phase: :send_startup
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> reason_rule pred: "socket_state_observed:remote:9042", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:9042:local_to_remote:byte_at:4:0xff:0x01", event: :packet_observed, narr: $startup_narrative, dedupe: true, mod: $module_name, phase: :send_startup

template :cassandra_startup_path
|> window :default_5s
|> use :cassandra_startup_rules
|> param :sock_lineage_fragment.capture_comm, true
