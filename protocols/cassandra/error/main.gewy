# gewyvern stable-subset protocol path

fn cassandra_error_rules() =
  let module_name = :cassandra_error_path
  let error_narrative = "static:observed a Cassandra native protocol ERROR frame"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :cassandra_error
  |> reason_model :cassandra_error_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> program_rule pred: "packet_observed:tcp:remote:9042:remote_to_local:byte_at:4:0xff:0x00", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_error
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> reason_rule pred: "packet_observed:tcp:remote:9042:remote_to_local:byte_at:4:0xff:0x00", event: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_error

template :cassandra_error_path
|> window :default_5s
|> use :cassandra_error_rules
|> param :sock_lineage_fragment.capture_comm, true
