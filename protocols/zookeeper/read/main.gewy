# gewyvern stable-subset protocol path

fn zookeeper_read_rules() =
  let module_name = :zookeeper_read_path
  let narrative = "static:observed a ZooKeeper znode read request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :zookeeper_read
  |> reason_model :zookeeper_read_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_ensemble
  |> program_rule pred: "packet_observed:tcp:remote:2181:local_to_remote", stage: :packet_observed, narr: $narrative, dedupe: true, mod: $module_name, phase: :send_read
  |> program_rule pred: "packet_observed:tcp:remote:2181:remote_to_local", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_read
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_ensemble
  |> reason_rule pred: "packet_observed:tcp:remote:2181:local_to_remote", event: :packet_observed, narr: $narrative, dedupe: true, mod: $module_name, phase: :send_read
  |> reason_rule pred: "packet_observed:tcp:remote:2181:remote_to_local", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_read

template :zookeeper_read_path
|> window :default_5s
|> use :zookeeper_read_rules
|> param :sock_lineage_fragment.capture_comm, true
