# gewyvern stable-subset protocol path

fn nbns_response_rules() =
  let module_name = :nbns_response_path
  let response_narrative = "static:observed a NetBIOS name response from a local name responder"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :nbns_response
  |> reason_model :nbns_response_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_local_link
  |> program_rule pred: "datagram_observed:udp:remote:nbns:remote_to_local:byte_at:2:0x80:0x80", stage: :datagram_observed, narr: $response_narrative, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_local_link
  |> reason_rule pred: "datagram_observed:udp:remote:nbns:remote_to_local:byte_at:2:0x80:0x80", event: :udp_datagram_seen, narr: $response_narrative, dedupe: true, mod: $module_name, phase: :receive_response

template :nbns_response_path
|> window :default_5s
|> use :nbns_response_rules
|> param :sock_lineage_fragment.capture_comm, true
