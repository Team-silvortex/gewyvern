# gewyvern stable-subset protocol path

fn ssh_session_rules() =
  let module_name = :ssh_session_path
  let route_narrative = "static:program resolved an upstream route for this SSH session"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:ssh_session)
  |> reason_model(:ssh_session_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "socket_state_observed:remote:ssh", stage: :socket_state_transition, narrative: "static:program initiated or advanced an SSH socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_server_banner)
  |> program_rule(predicate: "packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_client_banner)
  |> program_rule(predicate: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_key_exchange_init)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "socket_state_observed:remote:ssh", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_server_banner)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_client_banner)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_key_exchange_init)

template(:ssh_session_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:ssh_session_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
