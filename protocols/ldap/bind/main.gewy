fn ldap_bind_rules() = {
  |> fragment(:tcp_state_fragment)
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> program_model(:ldap_bind_path_model)
  |> operation(:ldap_bind)
  |> reason_model(:ldap_bind_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: :ldap_bind_path, phase: :bind)
  |> program_rule(predicate: :socket_state_observed:remote:ldap, stage: :socket_state_transition, narrative: :transport_socket_transition, dedupe: false, module: :ldap_bind_path, phase: :connect)
  |> program_rule(predicate: :socket_state_observed:remote:ldap:established, stage: :socket_state_transition, narrative: :transport_socket_transition, dedupe: true, module: :ldap_bind_path, phase: :establish)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: :ldap_bind_path, phase: :resolve_upstream)
  |> program_rule(predicate: :packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60, stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: :ldap_bind_path, phase: :send_bind)
  |> program_rule(predicate: :packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61, stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: :ldap_bind_path, phase: :receive_bind_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: :ldap_bind_path, phase: :bind)
  |> reason_rule(predicate: :socket_state_observed:remote:ldap, key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: :ldap_bind_path, phase: :connect)
  |> reason_rule(predicate: :socket_state_observed:remote:ldap:established, key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: :ldap_bind_path, phase: :establish)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: :ldap_bind_path, phase: :resolve_upstream)
  |> reason_rule(predicate: :packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60, key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: :ldap_bind_path, phase: :send_bind)
  |> reason_rule(predicate: :packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61, key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: :ldap_bind_path, phase: :receive_bind_response)
}

template(:ldap_bind_path)
|> window(:default_5s)
|> use(:ldap_bind_rules)
