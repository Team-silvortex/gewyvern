fn ldap_bind_rules() = {
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :ldap_bind_path_model
  |> operation :ldap_bind
  |> reason_model :ldap_bind_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: :ldap_bind_path, phase: :bind
  |> program_rule pred: :socket_state_observed:remote:ldap, stage: :socket_state_transition, narr: :transport_socket_transition, dedupe: false, mod: :ldap_bind_path, phase: :connect
  |> program_rule pred: :socket_state_observed:remote:ldap:established, stage: :socket_state_transition, narr: :transport_socket_transition, dedupe: true, mod: :ldap_bind_path, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: :ldap_bind_path, phase: :resolve_upstream
  |> program_rule pred: :packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60, stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: :ldap_bind_path, phase: :send_bind
  |> program_rule pred: :packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61, stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: :ldap_bind_path, phase: :receive_bind_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: :ldap_bind_path, phase: :bind
  |> reason_rule pred: :socket_state_observed:remote:ldap, event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: :ldap_bind_path, phase: :connect
  |> reason_rule pred: :socket_state_observed:remote:ldap:established, event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: :ldap_bind_path, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: :ldap_bind_path, phase: :resolve_upstream
  |> reason_rule pred: :packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60, event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: :ldap_bind_path, phase: :send_bind
  |> reason_rule pred: :packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61, event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: :ldap_bind_path, phase: :receive_bind_response
}

template :ldap_bind_path
|> window :default_5s
|> use :ldap_bind_rules
