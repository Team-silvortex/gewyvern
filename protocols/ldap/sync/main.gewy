template=ldap_directory_sync_session
window=default_5s
reason_model=ldap_directory_sync_session_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=ldap_directory_sync_session_model
operation=ldap_directory_sync_session
rule=process_bound;process_bound;process_bound;true;ldap_directory_sync_session;bind
rule=socket_state_observed:remote:ldap;socket_state_transition;static:program initiated or advanced an LDAP socket state transition;false;ldap_directory_sync_session;connect
rule=socket_state_observed:remote:ldap:established;socket_state_transition;static:program reached an established LDAP socket state;true;ldap_directory_sync_session;establish
rule=route_resolved;route_resolved;static:program resolved an upstream route for this LDAP directory sync session;true;ldap_directory_sync_session;resolve_upstream
rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_bind
rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_bind_response
rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x63;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_search
rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x65;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_search_result
rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x66;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_modify
rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x67:byte_at:9:0xff:0x00;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_modify_response
reason.rule=process_bound;process_identified;process_bound;true;ldap_directory_sync_session;bind
reason.rule=socket_state_observed:remote:ldap;state_change;tcp_state_transition;false;ldap_directory_sync_session;connect
reason.rule=socket_state_observed:remote:ldap:established;state_change;tcp_state_transition;true;ldap_directory_sync_session;establish
reason.rule=route_resolved;route_changed;route_changed;true;ldap_directory_sync_session;resolve_upstream
reason.rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_bind
reason.rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_bind_response
reason.rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x63;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_search
reason.rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x65;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_search_result
reason.rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x66;packet_observed;transport_payload_sent;true;ldap_directory_sync_session;send_modify
reason.rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x67:byte_at:9:0xff:0x00;packet_observed;transport_payload_received;true;ldap_directory_sync_session;receive_modify_response
