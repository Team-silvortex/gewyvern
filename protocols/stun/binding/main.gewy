# gewyvern DSL v0
template=stun_binding_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=stun_binding_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=stun_binding
rule=process_bound;process_bound;process_bound;true;stun_binding_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this STUN path;true;stun_binding_path;resolve_upstream
rule=datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0001;datagram_observed;udp_datagram_sent;true;stun_binding_path;send_request
rule=datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0101;datagram_observed;udp_datagram_received;true;stun_binding_path;receive_response
reason.rule=process_bound;process_identified;process_bound;true;stun_binding_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;stun_binding_path;resolve_upstream
reason.rule=datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0001;udp_datagram_seen;udp_datagram_sent;true;stun_binding_path;send_request
reason.rule=datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0101;udp_datagram_seen;udp_datagram_received;true;stun_binding_path;receive_response
param=sock_lineage_fragment.capture_comm=true
