# gewyvern stable-subset protocol path

fn dhcpv6_solicit_rules() =
  let module_name = :dhcpv6_solicit_path
  let route_narrative = "static:program resolved an upstream route for this DHCPv6 solicit path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :dhcpv6_solicit
  |> reason_model :dhcpv6_solicit_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:local:dhcpv6_client:remote:dhcpv6_server:local_to_remote:byte0_mask:0xff:0x01", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_solicit
  |> program_rule pred: "datagram_observed:udp:local:dhcpv6_client:remote:dhcpv6_server:remote_to_local:byte0_mask:0xff:0x02", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_advertise
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:local:dhcpv6_client:remote:dhcpv6_server:local_to_remote:byte0_mask:0xff:0x01", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_solicit
  |> reason_rule pred: "datagram_observed:udp:local:dhcpv6_client:remote:dhcpv6_server:remote_to_local:byte0_mask:0xff:0x02", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_advertise

template :dhcpv6_solicit_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :dhcpv6_solicit_rules
|> param :sock_lineage_fragment.capture_comm, true
