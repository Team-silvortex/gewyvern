template=redis_ping_path
window=default_5s
reason_model=redis_ping_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=redis_ping_path_model
operation=redis_ping
rule=process_bound;process_bound;process_bound;true;redis_ping_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this Redis path;true;redis_ping_path;resolve_upstream
rule=packet_observed:tcp:remote:redis:local_to_remote:byte0_mask:0xff:0x2a;packet_observed;transport_payload_sent;true;redis_ping_path;send_ping
rule=packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2b504f4e;packet_observed;transport_payload_received;true;redis_ping_path;receive_pong
reason.rule=process_bound;process_identified;process_bound;true;redis_ping_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;redis_ping_path;resolve_upstream
reason.rule=packet_observed:tcp:remote:redis:local_to_remote:byte0_mask:0xff:0x2a;packet_observed;transport_payload_sent;true;redis_ping_path;send_ping
reason.rule=packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2b504f4e;packet_observed;transport_payload_received;true;redis_ping_path;receive_pong
