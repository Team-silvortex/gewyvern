# gewyvern stable-subset protocol path

fn redis_busygroup_rules() =
  let module_name = :redis_busygroup_path
  let route_narrative = "static:program resolved an upstream route for this Redis BUSYGROUP path"
  |> fragment :tcp_packet_meta_fragment
  |> param :tcp_packet_meta_fragment.sample_payload_offsets, 8
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :redis_busygroup
  |> reason_model :redis_busygroup_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:redis", stage: :socket_state_transition, narr: "static:program initiated or advanced a Redis socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narr: "static:program reached an established Redis socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a350d0a:byte_at:5:0xff:0x36:byte_at:8:0xff:0x58:byte_at:9:0xff:0x47:byte_at:10:0xff:0x52:byte_at:13:0xff:0x50", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_xgroup
  |> program_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d425553", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_busygroup_error
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:redis", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:redis:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a350d0a:byte_at:5:0xff:0x36:byte_at:8:0xff:0x58:byte_at:9:0xff:0x47:byte_at:10:0xff:0x52:byte_at:13:0xff:0x50", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_xgroup
  |> reason_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d425553", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_busygroup_error

template :redis_busygroup_path
|> window :default_5s
|> use :redis_busygroup_rules
