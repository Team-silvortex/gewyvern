# gewyvern stable-subset protocol path

fn redis_noscript_rules() =
  let module_name = :redis_noscript_path
  let route_narrative = "static:program resolved an upstream route for this Redis NOSCRIPT path"
  |> fragment(:tcp_state_fragment)
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:redis_noscript)
  |> reason_model(:redis_noscript_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "socket_state_observed:remote:redis", stage: :socket_state_transition, narrative: "static:program initiated or advanced a Redis socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narrative: "static:program reached an established Redis socket state", dedupe: true, module: ${module_name}, phase: :establish)
  |> program_rule(predicate: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a320d0a:byte_at:8:0xff:0x45:byte_at:9:0xff:0x56:byte_at:10:0xff:0x41:byte_at:11:0xff:0x4c:byte_at:12:0xff:0x53:byte_at:13:0xff:0x48:byte_at:14:0xff:0x41", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_evalsha)
  |> program_rule(predicate: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d4e4f53", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_noscript_error)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "socket_state_observed:remote:redis", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "socket_state_observed:remote:redis:established", key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: ${module_name}, phase: :establish)
  |> reason_rule(predicate: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a320d0a:byte_at:8:0xff:0x45:byte_at:9:0xff:0x56:byte_at:10:0xff:0x41:byte_at:11:0xff:0x4c:byte_at:12:0xff:0x53:byte_at:13:0xff:0x48:byte_at:14:0xff:0x41", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_evalsha)
  |> reason_rule(predicate: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d4e4f53", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_noscript_error)

template(:redis_noscript_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:redis_noscript_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
