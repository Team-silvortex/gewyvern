# gewyvern stable-subset protocol path

fn redis_noscript_rules() =
  let module_name = :redis_noscript_path
  let route_narrative = "static:program resolved an upstream route for this Redis NOSCRIPT path"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :redis_noscript
  |> reason_model :redis_noscript_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:redis", stage: :socket_state_transition, narr: "static:program initiated or advanced a Redis socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narr: "static:program reached an established Redis socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a320d0a:byte_at:8:0xff:0x45:byte_at:9:0xff:0x56:byte_at:10:0xff:0x41:byte_at:11:0xff:0x4c:byte_at:12:0xff:0x53:byte_at:13:0xff:0x48:byte_at:14:0xff:0x41", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_evalsha
  |> program_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d4e4f53", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_noscript_error
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:redis", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:redis:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a320d0a:byte_at:8:0xff:0x45:byte_at:9:0xff:0x56:byte_at:10:0xff:0x41:byte_at:11:0xff:0x4c:byte_at:12:0xff:0x53:byte_at:13:0xff:0x48:byte_at:14:0xff:0x41", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_evalsha
  |> reason_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:prefix4:0x2d4e4f53", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_noscript_error

template :redis_noscript_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :redis_noscript_rules
|> param :sock_lineage_fragment.capture_comm, true
