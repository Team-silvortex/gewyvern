# gewyvern stable-subset protocol path

fn redis_mget_rules() =
  let module_name = :redis_mget_path
  let route_narrative = "static:program resolved an upstream route for this Redis MGET path"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :redis_mget_path_model
  |> operation :redis_mget
  |> reason_model :redis_mget_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:redis", stage: :socket_state_transition, narr: "static:program initiated or advanced a Redis socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narr: "static:program reached an established Redis socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a330d0a:byte_at:8:0xff:0x4d:byte_at:9:0xff:0x47:byte_at:10:0xff:0x45:byte_at:11:0xff:0x54", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_mget
  |> program_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x2a", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_array
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:redis", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:redis:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a330d0a:byte_at:8:0xff:0x4d:byte_at:9:0xff:0x47:byte_at:10:0xff:0x45:byte_at:11:0xff:0x54", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_mget
  |> reason_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x2a", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_array

template :redis_mget_path
|> window :default_5s
|> use :redis_mget_rules
