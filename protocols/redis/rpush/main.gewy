# gewyvern stable-subset protocol path

fn redis_rpush_rules() =
  let module_name = :redis_rpush_path
  let route_narrative = "static:program resolved an upstream route for this Redis RPUSH path"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :redis_rpush_path_model
  |> operation :redis_rpush
  |> reason_model :redis_rpush_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:redis", stage: :socket_state_transition, narr: "static:program initiated or advanced a Redis socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narr: "static:program reached an established Redis socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a330d0a:byte_at:8:0xff:0x52:byte_at:9:0xff:0x50:byte_at:10:0xff:0x55:byte_at:11:0xff:0x53:byte_at:12:0xff:0x48", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_rpush
  |> program_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x3a", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_integer
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:redis", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:redis:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a330d0a:byte_at:8:0xff:0x52:byte_at:9:0xff:0x50:byte_at:10:0xff:0x55:byte_at:11:0xff:0x53:byte_at:12:0xff:0x48", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_rpush
  |> reason_rule pred: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x3a", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_integer

template :redis_rpush_path
|> window :default_5s
|> use :redis_rpush_rules
