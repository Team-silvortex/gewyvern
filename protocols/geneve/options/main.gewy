# gewyvern stable-subset protocol path

fn geneve_options_rules() =
  let module_name = :geneve_options_path
  let options_narrative = "static:observed a GENEVE packet carrying option metadata"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :geneve_options
  |> reason_model :geneve_options_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> program_rule pred: "datagram_observed:udp:remote:geneve:local_to_remote:byte0_mask:0x3f:0x04", stage: :datagram_observed, narr: $options_narrative, dedupe: true, mod: $module_name, phase: :send_optioned_packet
  |> program_rule pred: "datagram_observed:udp:remote:geneve:remote_to_local:byte0_mask:0x3f:0x04", stage: :datagram_observed, narr: $options_narrative, dedupe: true, mod: $module_name, phase: :receive_optioned_packet
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> reason_rule pred: "datagram_observed:udp:remote:geneve:local_to_remote:byte0_mask:0x3f:0x04", event: :udp_datagram_seen, narr: $options_narrative, dedupe: true, mod: $module_name, phase: :send_optioned_packet
  |> reason_rule pred: "datagram_observed:udp:remote:geneve:remote_to_local:byte0_mask:0x3f:0x04", event: :udp_datagram_seen, narr: $options_narrative, dedupe: true, mod: $module_name, phase: :receive_optioned_packet

template :geneve_options_path
|> window :default_5s
|> use :geneve_options_rules
