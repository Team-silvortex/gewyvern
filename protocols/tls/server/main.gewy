# gewyvern stable-subset protocol path

fn tls_server_rules() =
  let module_name = :tls_server_path
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :tls_server
  |> reason_model :tls_server_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:local:https", stage: :socket_state_transition, narr: "static:program accepted or advanced a TLS server socket", dedupe: false, mod: $module_name, phase: :accept
  |> program_rule pred: "socket_state_observed:local:https:established", stage: :socket_state_transition, narr: "static:program reached an established TLS server socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote_to_local", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_client_hello
  |> program_rule pred: "packet_observed:tcp:local_to_remote", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_server_hello
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:local:https", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :accept
  |> reason_rule pred: "socket_state_observed:local:https:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote_to_local", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_client_hello
  |> reason_rule pred: "packet_observed:tcp:local_to_remote", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_server_hello

template :tls_server_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :tls_server_rules
|> param :sock_lineage_fragment.capture_comm, true
