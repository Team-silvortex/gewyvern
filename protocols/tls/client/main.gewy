# gewyvern stable-subset protocol path

fn tls_client_rules() =
  let module_name = :tls_client_path
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :tls_client
  |> reason_model :tls_client_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:https", stage: :socket_state_transition, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:https:established", stage: :socket_state_transition, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:local_to_remote", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_client_hello
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:https", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:https:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:local_to_remote", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_client_hello

template :tls_client_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :tls_client_rules
|> param :sock_lineage_fragment.capture_comm, true
