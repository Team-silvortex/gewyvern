# gewyvern stable-subset protocol path

fn tftp_write_rules() =
  let module_name = :tftp_write_path
  let route_narrative = "static:program resolved an upstream route for this TFTP write request"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :tftp_write
  |> reason_model :tftp_write_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:tftp:local_to_remote:prefix2:0x0002", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_write_request
  |> program_rule pred: "datagram_observed:udp:remote:tftp:remote_to_local:prefix2:0x0004", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_ack
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:tftp:local_to_remote:prefix2:0x0002", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_write_request
  |> reason_rule pred: "datagram_observed:udp:remote:tftp:remote_to_local:prefix2:0x0004", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_ack

template :tftp_write_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :tftp_write_rules
|> param :sock_lineage_fragment.capture_comm, true
