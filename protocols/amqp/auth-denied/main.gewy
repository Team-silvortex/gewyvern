# gewyvern stable-subset protocol path

fn amqp_auth_denied_rules() =
  let module_name = :amqp_auth_denied_path
  let route_narrative = "static:program resolved an upstream route for this AMQP auth-denied path"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :amqp_auth_denied
  |> reason_model :amqp_auth_denied_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:amqp", stage: :socket_state_transition, narr: "static:program initiated or advanced an AMQP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:amqp:established", stage: :socket_state_transition, narr: "static:program reached an established AMQP socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:prefix4:0x414d5150", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_protocol_header
  |> program_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0a", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_start
  |> program_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0b", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_start_ok
  |> program_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x32", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connection_close
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:amqp", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:amqp:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:prefix4:0x414d5150", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_protocol_header
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0a", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_start
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0b", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_start_ok
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x32", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connection_close

template :amqp_auth_denied_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :amqp_auth_denied_rules
|> param :sock_lineage_fragment.capture_comm, true
