# gewyvern DSL v0
template=amqp_basic_publish_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=amqp_basic_publish_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=amqp_basic_publish
rule=process_bound;process_bound;process_bound;true;amqp_basic_publish_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this AMQP publish path;true;amqp_basic_publish_path;resolve_upstream
rule=socket_state_observed:remote:amqp;socket_state_transition;static:program initiated or advanced an AMQP socket state transition;false;amqp_basic_publish_path;connect
rule=socket_state_observed:remote:amqp:established;socket_state_transition;static:program reached an established AMQP socket state;true;amqp_basic_publish_path;establish
rule=packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x28;packet_observed;transport_payload_sent;true;amqp_basic_publish_path;send_publish
rule=packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x50;packet_observed;transport_payload_received;true;amqp_basic_publish_path;receive_ack
reason.rule=process_bound;process_identified;process_bound;true;amqp_basic_publish_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;amqp_basic_publish_path;resolve_upstream
reason.rule=socket_state_observed:remote:amqp;state_change;tcp_state_transition;false;amqp_basic_publish_path;connect
reason.rule=socket_state_observed:remote:amqp:established;state_change;tcp_state_transition;true;amqp_basic_publish_path;establish
reason.rule=packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x28;packet_observed;transport_payload_sent;true;amqp_basic_publish_path;send_publish
reason.rule=packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x50;packet_observed;transport_payload_received;true;amqp_basic_publish_path;receive_ack
param=sock_lineage_fragment.capture_comm=true
