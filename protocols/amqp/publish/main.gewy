# gewyvern stable-subset protocol path

fn amqp_basic_publish_rules() =
  let module_name = :amqp_basic_publish_path
  let route_narrative = "static:program resolved an upstream route for this AMQP publish path"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :amqp_basic_publish
  |> reason_model :amqp_basic_publish_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:amqp", stage: :socket_state_transition, narr: "static:program initiated or advanced an AMQP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:amqp:established", stage: :socket_state_transition, narr: "static:program reached an established AMQP socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x28", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_publish
  |> program_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x50", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ack
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:amqp", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:amqp:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x28", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_publish
  |> reason_rule pred: "packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x50", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ack

template :amqp_basic_publish_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :amqp_basic_publish_rules
|> param :sock_lineage_fragment.capture_comm, true
