# gewyvern stable-subset protocol path

fn jaeger_collector_rules() =
  let module_name = :jaeger_collector_path
  let collector_narrative = "static:observed a Jaeger collector span ingest request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :jaeger_collector
  |> reason_model :jaeger_collector_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", stage: :packet_observed, narr: $collector_narrative, dedupe: true, mod: $module_name, phase: :send_spans
  |> program_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_collector_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", event: :packet_observed, narr: $collector_narrative, dedupe: true, mod: $module_name, phase: :send_spans
  |> reason_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_collector_response

template :jaeger_collector_path
|> window(duration_ms: 10000, lateness_ms: 300)
|> use :jaeger_collector_rules
|> param :sock_lineage_fragment.capture_comm, true
