# gewyvern stable-subset protocol path

fn radius_denied_rules() =
  let module_name = :radius_denied_path
  let route_narrative = "static:program resolved an upstream route for this RADIUS denied path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :radius_denied
  |> reason_model :radius_denied_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:radius:local_to_remote:byte0_mask:0xff:0x01", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_access_request
  |> program_rule pred: "datagram_observed:udp:remote:radius:remote_to_local:byte0_mask:0xff:0x03", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_access_reject
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:radius:local_to_remote:byte0_mask:0xff:0x01", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_access_request
  |> reason_rule pred: "datagram_observed:udp:remote:radius:remote_to_local:byte0_mask:0xff:0x03", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_access_reject

template :radius_denied_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :radius_denied_rules
|> param :sock_lineage_fragment.capture_comm, true
