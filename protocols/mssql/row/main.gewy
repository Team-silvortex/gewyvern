# gewyvern stable-subset protocol path

fn mssql_row_rules() =
  let module_name = :mssql_row_path
  let row_narrative = "static:observed a TDS row token from SQL Server"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mssql_row
  |> reason_model :mssql_row_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xd1", stage: :packet_observed, narr: $row_narrative, dedupe: true, mod: $module_name, phase: :receive_row
  |> program_rule pred: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xd2", stage: :packet_observed, narr: $row_narrative, dedupe: true, mod: $module_name, phase: :receive_nbcrow
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xd1", event: :packet_observed, narr: $row_narrative, dedupe: true, mod: $module_name, phase: :receive_row
  |> reason_rule pred: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xd2", event: :packet_observed, narr: $row_narrative, dedupe: true, mod: $module_name, phase: :receive_nbcrow

template :mssql_row_path
|> window :default_5s
|> use :mssql_row_rules
|> param :sock_lineage_fragment.capture_comm, true
