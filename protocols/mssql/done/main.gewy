# gewyvern stable-subset protocol path

fn mssql_done_rules() =
  let module_name = :mssql_done_path
  let done_narrative = "static:observed a TDS DONE-family token in a SQL Server response"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:mssql_done)
  |> reason_model(:mssql_done_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> program_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xfd", stage: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_done)
  |> program_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xfe", stage: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_doneproc)
  |> program_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xff", stage: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_doneinproc)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> reason_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xfd", key_event: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_done)
  |> reason_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xfe", key_event: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_doneproc)
  |> reason_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0xff", key_event: :packet_observed, narrative: ${done_narrative}, dedupe: true, module: ${module_name}, phase: :receive_doneinproc)

template(:mssql_done_path)
|> window(:default_5s)
|> use(:mssql_done_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
