# gewyvern stable-subset protocol path

fn mssql_query_rules() =
  let module_name = :mssql_query_path
  let query_narrative = "static:observed a TDS SQL batch packet sent to SQL Server"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mssql_query
  |> reason_model :mssql_query_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "socket_state_observed:remote:1433", stage: :socket_state_transition, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:1433:local_to_remote:byte0_mask:0xff:0x01", stage: :packet_observed, narr: $query_narrative, dedupe: true, mod: $module_name, phase: :send_sql_batch
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "socket_state_observed:remote:1433", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:1433:local_to_remote:byte0_mask:0xff:0x01", event: :packet_observed, narr: $query_narrative, dedupe: true, mod: $module_name, phase: :send_sql_batch

template :mssql_query_path
|> window :default_5s
|> use :mssql_query_rules
|> param :sock_lineage_fragment.capture_comm, true
