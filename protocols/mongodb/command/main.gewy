# gewyvern stable-subset protocol path

fn mongodb_command_rules() =
  let module_name = :mongodb_command_path
  let command_narrative = "static:observed a MongoDB OP_MSG command sent to the server"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mongodb_command
  |> reason_model :mongodb_command_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "socket_state_observed:remote:27017", stage: :socket_state_transition, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:27017:local_to_remote:bytes_at:12:0xdd,0x07,0x00,0x00", stage: :packet_observed, narr: $command_narrative, dedupe: true, mod: $module_name, phase: :send_op_msg
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "socket_state_observed:remote:27017", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:27017:local_to_remote:bytes_at:12:0xdd,0x07,0x00,0x00", event: :packet_observed, narr: $command_narrative, dedupe: true, mod: $module_name, phase: :send_op_msg

template :mongodb_command_path
|> window :default_5s
|> use :mongodb_command_rules
|> param :sock_lineage_fragment.capture_comm, true
