# gewyvern stable-subset protocol path

fn mongodb_query_failure_rules() =
  let module_name = :mongodb_query_failure_path
  let failure_narrative = "static:observed a legacy MongoDB OP_REPLY QueryFailure response"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mongodb_query_failure
  |> reason_model :mongodb_query_failure_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "packet_observed:tcp:remote:27017:remote_to_local:bytes_at:12:0x01,0x00,0x00,0x00:byte_at:16:0x02:0x02", stage: :packet_observed, narr: $failure_narrative, dedupe: true, mod: $module_name, phase: :receive_query_failure
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "packet_observed:tcp:remote:27017:remote_to_local:bytes_at:12:0x01,0x00,0x00,0x00:byte_at:16:0x02:0x02", event: :packet_observed, narr: $failure_narrative, dedupe: true, mod: $module_name, phase: :receive_query_failure

template :mongodb_query_failure_path
|> window :default_5s
|> use :mongodb_query_failure_rules
|> param :sock_lineage_fragment.capture_comm, true
