# gewyvern stable-subset protocol path

fn mdns_probe_rules() =
  let module_name = :mdns_probe_path
  let route_narrative = "static:program resolved a local multicast route for this mDNS probe path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:mdns_probe)
  |> reason_model(:mdns_probe_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_multicast)
  |> program_rule(predicate: "datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_probe)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_multicast)
  |> reason_rule(predicate: "datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_probe)

template(:mdns_probe_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:mdns_probe_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
