# gewyvern stable-subset protocol path

fn mdns_query_rules() =
  let module_name = :mdns_query_path
  let route_narrative = "static:program resolved a local multicast route for this mDNS path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mdns_query
  |> reason_model :mdns_query_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> program_rule pred: "datagram_observed:udp:local:mdns:remote:mdns:remote_to_local:prefix4:0x00008400", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> reason_rule pred: "datagram_observed:udp:local:mdns:remote:mdns:remote_to_local:prefix4:0x00008400", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response

template :mdns_query_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :mdns_query_rules
|> param :sock_lineage_fragment.capture_comm, true
