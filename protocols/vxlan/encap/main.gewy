# gewyvern stable-subset protocol path

fn vxlan_encap_rules() =
  let module_name = :vxlan_encap_path
  let encap_narrative = "static:observed a VXLAN overlay packet on UDP port 4789"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :vxlan_encap
  |> reason_model :vxlan_encap_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> program_rule pred: "datagram_observed:udp:remote:vxlan:local_to_remote", stage: :datagram_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :send_overlay_packet
  |> program_rule pred: "datagram_observed:udp:remote:vxlan:remote_to_local", stage: :datagram_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :receive_overlay_packet
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> reason_rule pred: "datagram_observed:udp:remote:vxlan:local_to_remote", event: :udp_datagram_seen, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :send_overlay_packet
  |> reason_rule pred: "datagram_observed:udp:remote:vxlan:remote_to_local", event: :udp_datagram_seen, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :receive_overlay_packet

template :vxlan_encap_path
|> window :default_5s
|> use :vxlan_encap_rules
