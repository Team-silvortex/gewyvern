# gewyvern stable-subset protocol path

fn vxlan_vni_rules() =
  let module_name = :vxlan_vni_path
  let vni_narrative = "static:observed a VXLAN packet with the VNI-present flag set"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :vxlan_vni
  |> reason_model :vxlan_vni_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> program_rule pred: "datagram_observed:udp:remote:vxlan:local_to_remote:byte0_mask:0x08:0x08", stage: :datagram_observed, narr: $vni_narrative, dedupe: true, mod: $module_name, phase: :send_vni_marked_packet
  |> program_rule pred: "datagram_observed:udp:remote:vxlan:remote_to_local:byte0_mask:0x08:0x08", stage: :datagram_observed, narr: $vni_narrative, dedupe: true, mod: $module_name, phase: :receive_vni_marked_packet
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_overlay
  |> reason_rule pred: "datagram_observed:udp:remote:vxlan:local_to_remote:byte0_mask:0x08:0x08", event: :udp_datagram_seen, narr: $vni_narrative, dedupe: true, mod: $module_name, phase: :send_vni_marked_packet
  |> reason_rule pred: "datagram_observed:udp:remote:vxlan:remote_to_local:byte0_mask:0x08:0x08", event: :udp_datagram_seen, narr: $vni_narrative, dedupe: true, mod: $module_name, phase: :receive_vni_marked_packet

template :vxlan_vni_path
|> window :default_5s
|> use :vxlan_vni_rules
