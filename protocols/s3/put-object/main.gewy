# gewyvern stable-subset protocol path

fn s3_put_object_rules() =
  let module_name = :s3_put_object_path
  let request_narrative = "static:observed an S3-compatible object upload request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :s3_put_object
  |> reason_model :s3_put_object_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_endpoint
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", stage: :packet_observed, narr: $request_narrative, dedupe: true, mod: $module_name, phase: :send_put_object
  |> program_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_endpoint
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", event: :packet_observed, narr: $request_narrative, dedupe: true, mod: $module_name, phase: :send_put_object
  |> reason_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response

template :s3_put_object_path
|> window :default_5s
|> use :s3_put_object_rules
|> param :sock_lineage_fragment.capture_comm, true
