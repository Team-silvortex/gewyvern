template=dns_tcp_query_path
window=default_5s
reason_model=dns_tcp_query_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=dns_tcp_query_path_model
operation=dns_tcp_query
rule=process_bound;process_bound;process_bound;true;dns_tcp_query_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this DNS-over-TCP path;true;dns_tcp_query_path;resolve_upstream
rule=packet_observed:tcp:remote:53:local_to_remote:byte4_mask:0x80:0x00;packet_observed;transport_payload_sent;true;dns_tcp_query_path;send_query
rule=packet_observed:tcp:remote:53:remote_to_local:byte4_mask:0x80:0x80;packet_observed;transport_payload_received;true;dns_tcp_query_path;receive_response
reason.rule=process_bound;process_identified;process_bound;true;dns_tcp_query_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;dns_tcp_query_path;resolve_upstream
reason.rule=packet_observed:tcp:remote:53:local_to_remote:byte4_mask:0x80:0x00;packet_observed;transport_payload_sent;true;dns_tcp_query_path;send_query
reason.rule=packet_observed:tcp:remote:53:remote_to_local:byte4_mask:0x80:0x80;packet_observed;transport_payload_received;true;dns_tcp_query_path;receive_response
