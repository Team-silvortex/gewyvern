# gewyvern stable-subset protocol path

fn dns_tcp_error_rules() =
  let module_name = :dns_tcp_error_path
  let error_narrative = "static:observed a TCP-carried DNS error response code"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :dns_tcp_error
  |> reason_model :dns_tcp_error_path_reason
  |> program_model :dns_tcp_error_path_model
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:53:remote_to_local:byte_at:4:0x80:0x80:byte_at:5:0x0f:0x01", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_formerr
  |> program_rule pred: "packet_observed:tcp:remote:53:remote_to_local:byte_at:4:0x80:0x80:byte_at:5:0x0f:0x02", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_servfail
  |> program_rule pred: "packet_observed:tcp:remote:53:remote_to_local:byte_at:4:0x80:0x80:byte_at:5:0x0f:0x03", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_nxdomain
  |> program_rule pred: "packet_observed:tcp:remote:53:remote_to_local:byte_at:4:0x80:0x80:byte_at:5:0x0f:0x05", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_refused
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:53:remote_to_local:byte_at:4:0x80:0x80:byte_at:5:0x0f:0x03", event: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_nxdomain

template :dns_tcp_error_path
|> window :default_5s
|> use :dns_tcp_error_rules
|> param :sock_lineage_fragment.capture_comm, true
