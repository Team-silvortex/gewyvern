# gewyvern stable-subset protocol path

fn websocket_close_rules() =
  let module_name = :websocket_close_path
  let close_narrative = "static:observed a WebSocket close control frame on an established TCP stream"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:websocket_close)
  |> reason_model(:websocket_close_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_endpoint)
  |> program_rule(predicate: "packet_observed:tcp:local_to_remote:byte_at:0:0x0f:0x08", stage: :packet_observed, narrative: ${close_narrative}, dedupe: true, module: ${module_name}, phase: :send_close)
  |> program_rule(predicate: "packet_observed:tcp:remote_to_local:byte_at:0:0x0f:0x08", stage: :packet_observed, narrative: ${close_narrative}, dedupe: true, module: ${module_name}, phase: :receive_close)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_endpoint)
  |> reason_rule(predicate: "packet_observed:tcp:local_to_remote:byte_at:0:0x0f:0x08", key_event: :packet_observed, narrative: ${close_narrative}, dedupe: true, module: ${module_name}, phase: :send_close)
  |> reason_rule(predicate: "packet_observed:tcp:remote_to_local:byte_at:0:0x0f:0x08", key_event: :packet_observed, narrative: ${close_narrative}, dedupe: true, module: ${module_name}, phase: :receive_close)

template(:websocket_close_path)
|> window(:default_5s)
|> use(:websocket_close_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
