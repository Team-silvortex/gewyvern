# gewyvern stable-subset protocol path

fn nats_pub_rules() =
  let module_name = :nats_pub_path
  let pub_narrative = "static:observed a NATS PUB command on TCP port 4222"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> operation(:nats_pub)
  |> reason_model(:nats_pub_path_reason)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> program_rule(predicate: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x50554220", stage: :packet_observed, narrative: ${pub_narrative}, dedupe: true, module: ${module_name}, phase: :send_publish)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> reason_rule(predicate: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x50554220", key_event: :packet_observed, narrative: ${pub_narrative}, dedupe: true, module: ${module_name}, phase: :send_publish)

template(:nats_pub_path)
|> window(:default_5s)
|> use(:nats_pub_rules)
