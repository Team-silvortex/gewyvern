# gewyvern stable-subset protocol path

fn nats_pub_rules() =
  let module_name = :nats_pub_path
  let pub_narrative = "static:observed a NATS PUB command on TCP port 4222"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :nats_pub
  |> reason_model :nats_pub_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x50554220", stage: :packet_observed, narr: $pub_narrative, dedupe: true, mod: $module_name, phase: :send_publish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x50554220", event: :packet_observed, narr: $pub_narrative, dedupe: true, mod: $module_name, phase: :send_publish

template :nats_pub_path
|> window :default_5s
|> use :nats_pub_rules
