# gewyvern stable-subset protocol path

fn nats_error_rules() =
  let module_name = :nats_error_path
  let error_narrative = "static:observed a NATS -ERR server response on TCP port 4222"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> operation(:nats_error)
  |> reason_model(:nats_error_path_reason)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> program_rule(predicate: "packet_observed:tcp:remote:nats:remote_to_local:prefix4:0x2d455252", stage: :packet_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_error)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> reason_rule(predicate: "packet_observed:tcp:remote:nats:remote_to_local:prefix4:0x2d455252", key_event: :packet_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_error)

template(:nats_error_path)
|> window(:default_5s)
|> use(:nats_error_rules)
