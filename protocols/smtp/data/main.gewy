# gewyvern stable-subset protocol path

fn smtp_data_rules() =
  let module_name = :smtp_data_path
  let route_narrative = "static:program resolved an upstream route for this SMTP data session"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :smtp_data
  |> reason_model :smtp_data_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:smtp", stage: :socket_state_transition, narr: "static:program initiated or advanced an SMTP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32323020", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_banner
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x45484c4f", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_ehlo
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32353020", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ehlo_ok
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x41555448", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32333520", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x4d41494c", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_mail_from
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_mail_ok
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x52435054", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_rcpt_to
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e,0x35", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_rcpt_ok
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x44415441", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_data
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x33353420", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_data_ready
  |> program_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:bytes_at:0:0x0d,0x0a,0x2e,0x0d,0x0a", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_message_body
  |> program_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x30,0x2e,0x30", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_message_queued
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:smtp", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32323020", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_banner
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x45484c4f", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_ehlo
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32353020", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ehlo_ok
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x41555448", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32333520", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x4d41494c", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_mail_from
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_mail_ok
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x52435054", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_rcpt_to
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e,0x35", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_rcpt_ok
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x44415441", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_data
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x33353420", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_data_ready
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:local_to_remote:bytes_at:0:0x0d,0x0a,0x2e,0x0d,0x0a", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_message_body
  |> reason_rule pred: "packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x30,0x2e,0x30", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_message_queued

template :smtp_data_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :smtp_data_rules
|> param :sock_lineage_fragment.capture_comm, true
