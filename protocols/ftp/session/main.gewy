# gewyvern DSL v0
template=ftp_session_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=ftp_session_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=ftp_session
rule=process_bound;process_bound;process_bound;true;ftp_session_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this FTP session;true;ftp_session_path;resolve_upstream
rule=socket_state_observed:remote:ftp;socket_state_transition;static:program initiated or advanced an FTP socket state transition;false;ftp_session_path;connect
rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020;packet_observed;transport_payload_received;true;ftp_session_path;receive_banner
rule=packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552;packet_observed;transport_payload_sent;true;ftp_session_path;send_auth_user
rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120;packet_observed;transport_payload_received;true;ftp_session_path;receive_password_required
rule=packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353;packet_observed;transport_payload_sent;true;ftp_session_path;send_auth_pass
rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32333020;packet_observed;transport_payload_received;true;ftp_session_path;receive_auth_ok
reason.rule=process_bound;process_identified;process_bound;true;ftp_session_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;ftp_session_path;resolve_upstream
reason.rule=socket_state_observed:remote:ftp;state_change;tcp_state_transition;false;ftp_session_path;connect
reason.rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020;packet_observed;transport_payload_received;true;ftp_session_path;receive_banner
reason.rule=packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552;packet_observed;transport_payload_sent;true;ftp_session_path;send_auth_user
reason.rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120;packet_observed;transport_payload_received;true;ftp_session_path;receive_password_required
reason.rule=packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353;packet_observed;transport_payload_sent;true;ftp_session_path;send_auth_pass
reason.rule=packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32333020;packet_observed;transport_payload_received;true;ftp_session_path;receive_auth_ok
param=sock_lineage_fragment.capture_comm=true
