# gewyvern stable-subset protocol path

fn syslog_udp_message_rules() =
  let module_name = :syslog_udp_message_path
  let message_narrative = "static:program emitted a syslog datagram beginning with PRI"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :syslog_udp_message
  |> reason_model :syslog_udp_message_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_route
  |> program_rule pred: "datagram_observed:udp:remote:syslog:local_to_remote:byte0_mask:0xff:0x3c", stage: :datagram_observed, narr: $message_narrative, dedupe: true, mod: $module_name, phase: :send_syslog_message
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_route
  |> reason_rule pred: "datagram_observed:udp:remote:syslog:local_to_remote:byte0_mask:0xff:0x3c", event: :udp_datagram_seen, narr: $message_narrative, dedupe: true, mod: $module_name, phase: :send_syslog_message

template :syslog_udp_message_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :syslog_udp_message_rules
|> param :sock_lineage_fragment.capture_comm, true
