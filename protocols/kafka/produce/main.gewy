# gewyvern stable-subset protocol path

fn kafka_produce_rules() =
  let module_name = :kafka_produce_path
  let produce_narrative = "static:observed a Kafka Produce request or response on TCP port 9092"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :kafka_produce
  |> reason_model :kafka_produce_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_broker
  |> program_rule pred: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x00", stage: :packet_observed, narr: $produce_narrative, dedupe: true, mod: $module_name, phase: :send_produce_request
  |> program_rule pred: "packet_observed:tcp:remote:kafka:remote_to_local", stage: :packet_observed, narr: $produce_narrative, dedupe: true, mod: $module_name, phase: :receive_produce_response
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_broker
  |> reason_rule pred: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x00", event: :packet_observed, narr: $produce_narrative, dedupe: true, mod: $module_name, phase: :send_produce_request
  |> reason_rule pred: "packet_observed:tcp:remote:kafka:remote_to_local", event: :packet_observed, narr: $produce_narrative, dedupe: true, mod: $module_name, phase: :receive_produce_response

template :kafka_produce_path
|> window :default_5s
|> use :kafka_produce_rules
