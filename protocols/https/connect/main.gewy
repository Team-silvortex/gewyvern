fn https_connect_rules() = {
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :https_connect
  |> reason_model :https_connect_process_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: :https_connect_path, phase: :bind
  |> program_rule pred: :socket_state_observed:remote:https, stage: :socket_state_transition, narr: :transport_socket_transition, dedupe: false, mod: :https_connect_path, phase: :connect
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: :https_connect_path, phase: :resolve_upstream
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: :https_connect_path, phase: :bind
  |> reason_rule pred: :socket_state_observed:remote:https, event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: :https_connect_path, phase: :connect
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: :https_connect_path, phase: :resolve_upstream
}

template :https_connect_process
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :https_connect_rules
|> param :sock_lineage_fragment.capture_comm, true
