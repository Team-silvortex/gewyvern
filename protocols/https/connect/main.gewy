fn https_connect_rules() = {
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:https_connect)
  |> reason_model(:https_connect_process_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: :https_connect_path, phase: :bind)
  |> program_rule(predicate: :socket_state_observed:remote:https, stage: :socket_state_transition, narrative: :transport_socket_transition, dedupe: false, module: :https_connect_path, phase: :connect)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: :https_connect_path, phase: :resolve_upstream)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: :https_connect_path, phase: :bind)
  |> reason_rule(predicate: :socket_state_observed:remote:https, key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: :https_connect_path, phase: :connect)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: :https_connect_path, phase: :resolve_upstream)
}

template(:https_connect_process)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:https_connect_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
