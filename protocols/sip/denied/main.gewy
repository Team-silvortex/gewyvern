# gewyvern stable-subset protocol path

fn sip_denied_rules() =
  let module_name = :sip_denied_path
  let route_narrative = "static:program resolved a route for this SIP denied response path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:sip_denied)
  |> reason_model(:sip_denied_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> program_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x34", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_4xx)
  |> program_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x35", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_5xx)
  |> program_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x36", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_6xx)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> reason_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x34", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_4xx)
  |> reason_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x35", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_5xx)
  |> reason_rule(predicate: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x36", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_6xx)

template(:sip_denied_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:sip_denied_rules)
|> param(:udp_packet_meta_fragment.sample_payload_offsets, 8)
|> param(:sock_lineage_fragment.capture_comm, true)
