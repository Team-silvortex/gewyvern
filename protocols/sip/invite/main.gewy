# gewyvern stable-subset protocol path

fn sip_invite_rules() =
  let module_name = :sip_invite_path
  let route_narrative = "static:program resolved a route for this SIP invite path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :sip_invite
  |> reason_model :sip_invite_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:sip:local_to_remote:prefix4:0x494e5649", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_invite
  |> program_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:prefix4:0x5349502f", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_ok
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:sip:local_to_remote:prefix4:0x494e5649", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_invite
  |> reason_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:prefix4:0x5349502f", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_ok

template :sip_invite_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :sip_invite_rules
|> param :sock_lineage_fragment.capture_comm, true
