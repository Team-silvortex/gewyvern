# gewyvern stable-subset protocol path

fn kerberos_tgs_rules() =
  let module_name = :kerberos_tgs_path
  let route_narrative = "static:program resolved an upstream route for this Kerberos TGS exchange"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:kerberos_tgs)
  |> reason_model(:kerberos_tgs_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:kerberos:local_to_remote:byte0_mask:0xff:0x6c", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_tgs_request)
  |> program_rule(predicate: "datagram_observed:udp:remote:kerberos:remote_to_local:byte0_mask:0xff:0x6d", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_tgs_reply)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:kerberos:local_to_remote:byte0_mask:0xff:0x6c", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_tgs_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote:kerberos:remote_to_local:byte0_mask:0xff:0x6d", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_tgs_reply)

template(:kerberos_tgs_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:kerberos_tgs_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
