# gewyvern stable-subset protocol path

fn imap_auth_denied_rules() =
  let module_name = :imap_auth_denied_path
  let route_narrative = "static:program resolved an upstream route for this IMAP auth session"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:imap_auth_denied)
  |> reason_model(:imap_auth_denied_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "socket_state_observed:remote:imap", stage: :socket_state_transition, narrative: "static:program initiated or advanced an IMAP socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x2a204f4b", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> program_rule(predicate: "packet_observed:tcp:remote:imap:local_to_remote:prefix4:0x41303031:bytes_at:5:0x4c,0x4f,0x47,0x49,0x4e", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_request)
  |> program_rule(predicate: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x41303031:bytes_at:5:0x4e,0x4f", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_denied)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "socket_state_observed:remote:imap", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x2a204f4b", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> reason_rule(predicate: "packet_observed:tcp:remote:imap:local_to_remote:prefix4:0x41303031:bytes_at:5:0x4c,0x4f,0x47,0x49,0x4e", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_request)
  |> reason_rule(predicate: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x41303031:bytes_at:5:0x4e,0x4f", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_denied)

template(:imap_auth_denied_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:imap_auth_denied_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
