# gewyvern stable-subset protocol path

fn socks5_session_rules() =
  let module_name = :socks5_session_path
  let route_narrative = "static:program resolved an upstream route for this SOCKS5 session"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :socks5_session
  |> reason_model :socks5_session_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:socks5", stage: :socket_state_transition, narr: "static:program initiated or advanced a SOCKS5 socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_method_greeting
  |> program_rule pred: "packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_method_selection
  |> program_rule pred: "packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01,0x00,0x03", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect_request
  |> program_rule pred: "packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00,0x00,0x01", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connect_success
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:socks5", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_method_greeting
  |> reason_rule pred: "packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_method_selection
  |> reason_rule pred: "packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01,0x00,0x03", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect_request
  |> reason_rule pred: "packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00,0x00,0x01", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connect_success

template :socks5_session_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :socks5_session_rules
|> param :sock_lineage_fragment.capture_comm, true
