# gewyvern stable-subset protocol path

fn postgres_query_session_rules() =
  let module_name = :postgres_query_session
  let route_narrative = "static:program resolved an upstream route for this PostgreSQL query session"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :postgres_query_session
  |> reason_model :postgres_query_session_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:postgres", stage: :socket_state_transition, narr: "static:program initiated or advanced a PostgreSQL socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:postgres:established", stage: :socket_state_transition, narr: "static:program reached an established PostgreSQL socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x52", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth
  |> program_rule pred: "packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x70", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_password
  |> program_rule pred: "packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x51", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> program_rule pred: "packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x5a", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ready
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:postgres", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:postgres:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x52", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth
  |> reason_rule pred: "packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x70", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_password
  |> reason_rule pred: "packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x51", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_query
  |> reason_rule pred: "packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x5a", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_ready

template :postgres_query_session
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :postgres_query_session_rules
|> param :sock_lineage_fragment.capture_comm, true
