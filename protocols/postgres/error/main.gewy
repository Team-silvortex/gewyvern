# gewyvern DSL v0
template=postgres_query_error_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=postgres_query_error_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=postgres_query_error
rule=process_bound;process_bound;process_bound;true;postgres_query_error_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this PostgreSQL query error path;true;postgres_query_error_path;resolve_upstream
rule=socket_state_observed:remote:postgres;socket_state_transition;static:program initiated or advanced a PostgreSQL socket state transition;false;postgres_query_error_path;connect
rule=socket_state_observed:remote:postgres:established;socket_state_transition;static:program reached an established PostgreSQL socket state;true;postgres_query_error_path;establish
rule=packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x51;packet_observed;transport_payload_sent;true;postgres_query_error_path;send_query
rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x45;packet_observed;transport_payload_received;true;postgres_query_error_path;receive_error
reason.rule=process_bound;process_identified;process_bound;true;postgres_query_error_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;postgres_query_error_path;resolve_upstream
reason.rule=socket_state_observed:remote:postgres;state_change;tcp_state_transition;false;postgres_query_error_path;connect
reason.rule=socket_state_observed:remote:postgres:established;state_change;tcp_state_transition;true;postgres_query_error_path;establish
reason.rule=packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x51;packet_observed;transport_payload_sent;true;postgres_query_error_path;send_query
reason.rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x45;packet_observed;transport_payload_received;true;postgres_query_error_path;receive_error
param=sock_lineage_fragment.capture_comm=true
