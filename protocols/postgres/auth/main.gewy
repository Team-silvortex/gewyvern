# gewyvern DSL v0
template=postgres_auth_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=postgres_auth_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=postgres_auth
rule=process_bound;process_bound;process_bound;true;postgres_auth_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this PostgreSQL auth path;true;postgres_auth_path;resolve_upstream
rule=socket_state_observed:remote:postgres;socket_state_transition;static:program initiated or advanced a PostgreSQL socket state transition;false;postgres_auth_path;connect
rule=socket_state_observed:remote:postgres:established;socket_state_transition;static:program reached an established PostgreSQL socket state;true;postgres_auth_path;establish
rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x52;packet_observed;transport_payload_received;true;postgres_auth_path;receive_auth
rule=packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x70;packet_observed;transport_payload_sent;true;postgres_auth_path;send_password
rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x5a;packet_observed;transport_payload_received;true;postgres_auth_path;receive_ready
reason.rule=process_bound;process_identified;process_bound;true;postgres_auth_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;postgres_auth_path;resolve_upstream
reason.rule=socket_state_observed:remote:postgres;state_change;tcp_state_transition;false;postgres_auth_path;connect
reason.rule=socket_state_observed:remote:postgres:established;state_change;tcp_state_transition;true;postgres_auth_path;establish
reason.rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x52;packet_observed;transport_payload_received;true;postgres_auth_path;receive_auth
reason.rule=packet_observed:tcp:remote:postgres:local_to_remote:byte0_mask:0xff:0x70;packet_observed;transport_payload_sent;true;postgres_auth_path;send_password
reason.rule=packet_observed:tcp:remote:postgres:remote_to_local:byte0_mask:0xff:0x5a;packet_observed;transport_payload_received;true;postgres_auth_path;receive_ready
param=sock_lineage_fragment.capture_comm=true
