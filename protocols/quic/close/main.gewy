# gewyvern stable-subset protocol path

fn quic_close_rules() =
  let module_name = :quic_close_path
  let route_narrative = "static:program resolved an upstream route for this QUIC close path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:quic_close_observation)
  |> reason_model(:quic_close_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "quic_packet_observed:remote:quic:local_to_remote:min_len:1200:long_header:true:type:initial", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_initial)
  |> program_rule(predicate: "quic_frame_observed:remote:quic:local_to_remote:type:initial:frame:crypto", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_crypto)
  |> program_rule(predicate: "quic_packet_observed:remote:quic:remote_to_local:long_header:true:type:handshake", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_handshake)
  |> program_rule(predicate: "quic_frame_observed:remote:quic:remote_to_local:type:handshake:frame:crypto", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_crypto)
  |> program_rule(predicate: "quic_frame_observed:remote:quic:remote_to_local:frame:connection_close", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_close)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "quic_packet_observed:remote:quic:local_to_remote:min_len:1200:long_header:true:type:initial", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_initial)
  |> reason_rule(predicate: "quic_frame_observed:remote:quic:local_to_remote:type:initial:frame:crypto", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_crypto)
  |> reason_rule(predicate: "quic_packet_observed:remote:quic:remote_to_local:long_header:true:type:handshake", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_handshake)
  |> reason_rule(predicate: "quic_frame_observed:remote:quic:remote_to_local:type:handshake:frame:crypto", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_crypto)
  |> reason_rule(predicate: "quic_frame_observed:remote:quic:remote_to_local:frame:connection_close", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_close)

template(:quic_close_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:quic_close_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
