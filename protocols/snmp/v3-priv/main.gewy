# gewyvern stable-subset protocol path

fn snmp_v3_priv_rules() =
  let module_name = :snmp_v3_priv_path
  let route_narrative = "static:program resolved an upstream route for this SNMPv3 privacy path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :snmp_v3_priv
  |> reason_model :snmp_v3_priv_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_v3_priv_request
  |> program_rule pred: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_v3_priv_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_v3_priv_request
  |> reason_rule pred: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_v3_priv_response

template :snmp_v3_priv_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :snmp_v3_priv_rules
|> param :sock_lineage_fragment.capture_comm, true
