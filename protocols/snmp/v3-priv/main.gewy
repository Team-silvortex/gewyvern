# gewyvern stable-subset protocol path

fn snmp_v3_priv_rules() =
  let module_name = :snmp_v3_priv_path
  let route_narrative = "static:program resolved an upstream route for this SNMPv3 privacy path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:snmp_v3_priv)
  |> reason_model(:snmp_v3_priv_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_v3_priv_request)
  |> program_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_v3_priv_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_v3_priv_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:18:0xff:0x03", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_v3_priv_response)

template(:snmp_v3_priv_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:snmp_v3_priv_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
