# gewyvern stable-subset protocol path

fn ntp_client_rules() =
  let module_name = :ntp_client_path
  let route_narrative = "static:program resolved an upstream route for this NTP path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :ntp_client
  |> reason_model :ntp_client_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "ntp_message_observed:remote:ntp:request", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_request
  |> program_rule pred: "ntp_message_observed:remote:ntp:response", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "ntp_message_observed:remote:ntp:request", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_request
  |> reason_rule pred: "ntp_message_observed:remote:ntp:response", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response

template :ntp_client_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :ntp_client_rules
|> param :sock_lineage_fragment.capture_comm, true
