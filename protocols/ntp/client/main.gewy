# gewyvern DSL v0
template=ntp_client_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=ntp_client_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=ntp_client
rule=process_bound;process_bound;process_bound;true;ntp_client_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this NTP path;true;ntp_client_path;resolve_upstream
rule=datagram_observed:udp:remote:ntp:local_to_remote:byte0_mask:0xff:0x23;datagram_observed;udp_datagram_sent;true;ntp_client_path;send_request
rule=datagram_observed:udp:remote:ntp:remote_to_local:byte0_mask:0xff:0x24;datagram_observed;udp_datagram_received;true;ntp_client_path;receive_response
reason.rule=process_bound;process_identified;process_bound;true;ntp_client_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;ntp_client_path;resolve_upstream
reason.rule=datagram_observed:udp:remote:ntp:local_to_remote:byte0_mask:0xff:0x23;udp_datagram_seen;udp_datagram_sent;true;ntp_client_path;send_request
reason.rule=datagram_observed:udp:remote:ntp:remote_to_local:byte0_mask:0xff:0x24;udp_datagram_seen;udp_datagram_received;true;ntp_client_path;receive_response
param=sock_lineage_fragment.capture_comm=true
