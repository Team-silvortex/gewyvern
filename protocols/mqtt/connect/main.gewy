# gewyvern stable-subset protocol path

fn mqtt_connect_rules() =
  let module_name = :mqtt_connect_path
  let route_narrative = "static:program resolved an upstream route for this MQTT path"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :mqtt_connect_path_model
  |> operation :mqtt_connect
  |> reason_model :mqtt_connect_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:mqtt:local_to_remote:byte0_mask:0xf0:0x10", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect
  |> program_rule pred: "packet_observed:tcp:remote:mqtt:remote_to_local:prefix4:0x20020000", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connack
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:mqtt:local_to_remote:byte0_mask:0xf0:0x10", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect
  |> reason_rule pred: "packet_observed:tcp:remote:mqtt:remote_to_local:prefix4:0x20020000", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connack

template :mqtt_connect_path
|> window :default_5s
|> use :mqtt_connect_rules
