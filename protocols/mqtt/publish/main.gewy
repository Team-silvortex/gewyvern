# gewyvern stable-subset protocol path

fn mqtt_publish_rules() =
  let module_name = :mqtt_publish_path
  let route_narrative = "static:program resolved an upstream route for this MQTT publish path"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> program_model(:mqtt_publish_path_model)
  |> operation(:mqtt_publish)
  |> reason_model(:mqtt_publish_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: "socket_state_observed:remote:mqtt", stage: :socket_state_transition, narrative: "static:program initiated or advanced an MQTT socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "socket_state_observed:remote:mqtt:established", stage: :socket_state_transition, narrative: "static:program reached an established MQTT socket state", dedupe: true, module: ${module_name}, phase: :establish)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "packet_observed:tcp:remote:mqtt:local_to_remote:byte0_mask:0xf0:0x30", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_publish)
  |> program_rule(predicate: "packet_observed:tcp:remote:mqtt:remote_to_local:prefix4:0x40020000", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_puback)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: "socket_state_observed:remote:mqtt", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "socket_state_observed:remote:mqtt:established", key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: ${module_name}, phase: :establish)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "packet_observed:tcp:remote:mqtt:local_to_remote:byte0_mask:0xf0:0x30", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_publish)
  |> reason_rule(predicate: "packet_observed:tcp:remote:mqtt:remote_to_local:prefix4:0x40020000", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_puback)

template(:mqtt_publish_path)
|> window(:default_5s)
|> use(:mqtt_publish_rules)
