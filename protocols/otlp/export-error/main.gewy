# gewyvern stable-subset protocol path

fn otlp_export_error_rules() =
  let module_name = :otlp_export_error_path
  let error_narrative = "static:observed OTLP export failure response from collector or gateway"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :otlp_export_error
  |> reason_model :otlp_export_error_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x01", stage: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_error_headers
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:4:0xff:0x05", stage: :packet_observed, narr: $error_narrative, dedupe: false, mod: $module_name, phase: :receive_error_status
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x01", event: :packet_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_error_headers
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:4:0xff:0x05", event: :packet_observed, narr: $error_narrative, dedupe: false, mod: $module_name, phase: :receive_error_status

template :otlp_export_error_path
|> window :default_5s
|> use :otlp_export_error_rules
