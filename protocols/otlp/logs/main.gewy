# gewyvern stable-subset protocol path

fn otlp_logs_rules() =
  let module_name = :otlp_logs_path
  let logs_narrative = "static:observed OTLP logs export over gRPC or HTTP"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :otlp_logs_export
  |> reason_model :otlp_logs_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> program_rule pred: "packet_observed:tcp:remote:https:local_to_remote:byte_at:3:0xff:0x01", stage: :packet_observed, narr: $logs_narrative, dedupe: true, mod: $module_name, phase: :send_log_headers
  |> program_rule pred: "packet_observed:tcp:remote:https:local_to_remote:byte_at:3:0xff:0x00", stage: :packet_observed, narr: :transport_payload_sent, dedupe: false, mod: $module_name, phase: :send_log_batch
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> reason_rule pred: "packet_observed:tcp:remote:https:local_to_remote:byte_at:3:0xff:0x01", event: :packet_observed, narr: $logs_narrative, dedupe: true, mod: $module_name, phase: :send_log_headers
  |> reason_rule pred: "packet_observed:tcp:remote:https:local_to_remote:byte_at:3:0xff:0x00", event: :packet_observed, narr: :transport_payload_sent, dedupe: false, mod: $module_name, phase: :send_log_batch

template :otlp_logs_path
|> window(duration_ms: 10000, lateness_ms: 300)
|> use :otlp_logs_rules
|> param :sock_lineage_fragment.capture_comm, true
