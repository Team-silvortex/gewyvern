{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gewyvern.dev/schemas/leserpent-wire-v1.json",
  "title": "Leserpent Wire Envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request"],
      "properties": {
        "schema_version": { "const": 1 },
        "request": {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": {
              "enum": [
                "command",
                "query",
                "health",
                "deployment_receipt",
                "orchestra_persist",
                "orchestra_history",
                "orchestra_delete",
                "runtime_unregister",
                "bootstrap_handoff",
                "bootstrap_session_bind"
              ]
            },
            "payload": { "type": "object" }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "response"],
      "properties": {
        "schema_version": { "const": 1 },
        "response": {
          "type": "object",
          "required": ["kind", "payload"],
          "properties": {
            "kind": {
              "enum": [
                "command",
                "query",
                "health",
                "deployment_receipt",
                "orchestra_persisted",
                "orchestra_history",
                "orchestra_deleted",
                "runtime_unregistered",
                "bootstrap_handoff",
                "error"
              ]
            },
            "payload": { "type": "object" }
          }
        }
      }
    }
  }
}
