template=tls_client_path
window.duration_ms=5000
window.lateness_ms=200
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=tls_client
rule=process_bound;process_bound;process_bound;true;tls_client_path;bind
rule=route_resolved;route_resolved;route_changed;true;tls_client_path;resolve_upstream
rule=socket_state_observed:https;socket_state_transition;tcp_state_transition;true;tls_client_path;connect
rule=socket_state_observed:https:established;socket_state_transition;tcp_state_transition;true;tls_client_path;establish
rule=packet_observed:tcp:egress;packet_observed;static:TLS client payload observed after establish;true;tls_client_path;send_client_hello
reason.rule=process_bound;process_bound;process_bound;true;tls_client_path;bind
reason.rule=route_resolved;route_resolved;route_changed;true;tls_client_path;resolve_upstream
reason.rule=socket_state_observed:https;socket_state_transition;tcp_state_transition;true;tls_client_path;connect
reason.rule=socket_state_observed:https:established;socket_state_transition;tcp_state_transition;true;tls_client_path;establish
reason.rule=packet_observed:tcp:egress;packet_observed;static:tls_client_payload_observed;true;tls_client_path;send_client_hello
