# gewyvern DSL v0
template=http3_server_response_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=http3_server_response_path_reason
fragment=udp_packet_meta_fragment
fragment=sock_lineage_fragment
operation=http3_server_response
rule=process_bound;process_bound;process_bound;true;http3_server_response_path;bind
rule=quic_packet_observed:local:quic:remote_to_local:min_len:1200:long_header:true:type:initial;datagram_observed;udp_datagram_received;true;http3_server_response_path;receive_initial
rule=quic_frame_observed:local:quic:remote_to_local:type:initial:frame:crypto;packet_observed;transport_payload_received;true;http3_server_response_path;receive_crypto
rule=quic_packet_observed:local:quic:local_to_remote:long_header:true:type:handshake;datagram_observed;udp_datagram_sent;true;http3_server_response_path;send_handshake
rule=quic_frame_observed:local:quic:local_to_remote:type:handshake:frame:crypto;packet_observed;transport_payload_sent;true;http3_server_response_path;send_crypto
rule=quic_frame_observed:local:quic:remote_to_local:frame:stream;packet_observed;transport_payload_received;true;http3_server_response_path;receive_request_stream
rule=quic_frame_observed:local:quic:local_to_remote:frame:stream;packet_observed;transport_payload_sent;true;http3_server_response_path;send_response_stream
rule=quic_frame_observed:local:quic:local_to_remote:frame:connection_close;packet_observed;transport_payload_sent;true;http3_server_response_path;send_close
reason.rule=process_bound;process_identified;process_bound;true;http3_server_response_path;bind
reason.rule=quic_packet_observed:local:quic:remote_to_local:min_len:1200:long_header:true:type:initial;udp_datagram_seen;udp_datagram_received;true;http3_server_response_path;receive_initial
reason.rule=quic_frame_observed:local:quic:remote_to_local:type:initial:frame:crypto;packet_observed;transport_payload_received;true;http3_server_response_path;receive_crypto
reason.rule=quic_packet_observed:local:quic:local_to_remote:long_header:true:type:handshake;udp_datagram_seen;udp_datagram_sent;true;http3_server_response_path;send_handshake
reason.rule=quic_frame_observed:local:quic:local_to_remote:type:handshake:frame:crypto;packet_observed;transport_payload_sent;true;http3_server_response_path;send_crypto
reason.rule=quic_frame_observed:local:quic:remote_to_local:frame:stream;packet_observed;transport_payload_received;true;http3_server_response_path;receive_request_stream
reason.rule=quic_frame_observed:local:quic:local_to_remote:frame:stream;packet_observed;transport_payload_sent;true;http3_server_response_path;send_response_stream
reason.rule=quic_frame_observed:local:quic:local_to_remote:frame:connection_close;packet_observed;transport_payload_sent;true;http3_server_response_path;send_close
param=sock_lineage_fragment.capture_comm=true
