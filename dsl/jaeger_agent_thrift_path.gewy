# gewyvern stable-subset protocol path

fn jaeger_agent_thrift_rules() =
  let module_name = :jaeger_agent_thrift_path
  let agent_narrative = "static:observed a Jaeger agent compact-thrift UDP span packet"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :jaeger_agent_thrift
  |> reason_model :jaeger_agent_thrift_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_agent
  |> program_rule pred: "datagram_observed:udp:local_to_remote", stage: :datagram_observed, narr: $agent_narrative, dedupe: false, mod: $module_name, phase: :send_agent_packet
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_agent
  |> reason_rule pred: "datagram_observed:udp:local_to_remote", event: :udp_datagram_seen, narr: $agent_narrative, dedupe: false, mod: $module_name, phase: :send_agent_packet

template :jaeger_agent_thrift_path
|> window(duration_ms: 10000, lateness_ms: 300)
|> use :jaeger_agent_thrift_rules
|> param :sock_lineage_fragment.capture_comm, true
