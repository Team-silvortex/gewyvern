# gewyvern stable-subset protocol path

fn arp_reply_rules() =
  let module_name = :arp_reply_path
  let reply_narrative = "static:observed an ARP is-at reply on the local link"
  |> fragment(:udp_packet_meta_fragment)
  |> param(:udp_packet_meta_fragment.sample_payload_offsets, "6,7")
  |> operation(:arp_reply)
  |> reason_model(:arp_reply_path_reason)
  |> program_rule(predicate: "packet_observed:0:remote_to_local:prefix4:0x00010800:byte_at:6:0xff:0x00:byte_at:7:0xff:0x02", stage: :packet_observed, narrative: ${reply_narrative}, dedupe: true, module: ${module_name}, phase: :receive_is_at)
  |> reason_rule(predicate: "packet_observed:0:remote_to_local:prefix4:0x00010800:byte_at:6:0xff:0x00:byte_at:7:0xff:0x02", key_event: :packet_observed, narrative: ${reply_narrative}, dedupe: true, module: ${module_name}, phase: :receive_is_at)

template(:arp_reply_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:arp_reply_rules)
