# gewyvern stable-subset protocol path

fn gre_encap_rules() =
  let module_name = :gre_encap_path
  let encap_narrative = "static:observed a GRE encapsulated packet on IP protocol 47"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :gre_encap
  |> reason_model :gre_encap_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_tunnel
  |> program_rule pred: "packet_observed:47:local_to_remote", stage: :packet_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :send_encapsulated_packet
  |> program_rule pred: "packet_observed:47:remote_to_local", stage: :packet_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :receive_encapsulated_packet
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_tunnel
  |> reason_rule pred: "packet_observed:47:local_to_remote", event: :packet_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :send_encapsulated_packet
  |> reason_rule pred: "packet_observed:47:remote_to_local", event: :packet_observed, narr: $encap_narrative, dedupe: true, mod: $module_name, phase: :receive_encapsulated_packet

template :gre_encap_path
|> window :default_5s
|> use :gre_encap_rules
