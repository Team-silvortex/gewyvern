# gewyvern stable-subset protocol path

fn consul_catalog_rules() =
  let module_name = :consul_catalog_path
  let narrative = "static:observed a Consul catalog API request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :consul_catalog
  |> reason_model :consul_catalog_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_agent
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", stage: :packet_observed, narr: $narrative, dedupe: true, mod: $module_name, phase: :send_catalog_query
  |> program_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_catalog
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_agent
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", event: :packet_observed, narr: $narrative, dedupe: true, mod: $module_name, phase: :send_catalog_query
  |> reason_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_catalog

template :consul_catalog_path
|> window :default_5s
|> use :consul_catalog_rules
|> param :sock_lineage_fragment.capture_comm, true
