# gewyvern stable-subset protocol path

fn stun_allocate_rules() =
  let module_name = :stun_allocate_path
  let route_narrative = "static:program resolved an upstream route for this STUN allocate path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :stun_allocate
  |> reason_model :stun_allocate_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0003", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_allocate_request
  |> program_rule pred: "datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0103", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_allocate_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0003", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_allocate_request
  |> reason_rule pred: "datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0103", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_allocate_response

template :stun_allocate_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :stun_allocate_rules
|> param :sock_lineage_fragment.capture_comm, true
