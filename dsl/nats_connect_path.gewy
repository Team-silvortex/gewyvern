# gewyvern stable-subset protocol path

fn nats_connect_rules() =
  let module_name = :nats_connect_path
  let connect_narrative = "static:observed a NATS CONNECT/INFO handshake on TCP port 4222"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :nats_connect
  |> reason_model :nats_connect_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "packet_observed:tcp:remote:nats:remote_to_local:prefix4:0x494e464f", stage: :packet_observed, narr: $connect_narrative, dedupe: true, mod: $module_name, phase: :receive_info
  |> program_rule pred: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x434f4e4e", stage: :packet_observed, narr: $connect_narrative, dedupe: true, mod: $module_name, phase: :send_connect
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "packet_observed:tcp:remote:nats:remote_to_local:prefix4:0x494e464f", event: :packet_observed, narr: $connect_narrative, dedupe: true, mod: $module_name, phase: :receive_info
  |> reason_rule pred: "packet_observed:tcp:remote:nats:local_to_remote:prefix4:0x434f4e4e", event: :packet_observed, narr: $connect_narrative, dedupe: true, mod: $module_name, phase: :send_connect

template :nats_connect_path
|> window :default_5s
|> use :nats_connect_rules
