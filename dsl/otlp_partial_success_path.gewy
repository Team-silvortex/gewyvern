# gewyvern stable-subset protocol path

fn otlp_partial_success_rules() =
  let module_name = :otlp_partial_success_path
  let partial_narrative = "static:observed OTLP export response that may contain partial success"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :otlp_partial_success
  |> reason_model :otlp_partial_success_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x00", stage: :packet_observed, narr: $partial_narrative, dedupe: false, mod: $module_name, phase: :receive_response_body
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x01", stage: :packet_observed, narr: $partial_narrative, dedupe: true, mod: $module_name, phase: :receive_response_headers
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_collector
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x00", event: :packet_observed, narr: $partial_narrative, dedupe: false, mod: $module_name, phase: :receive_response_body
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local:byte_at:3:0xff:0x01", event: :packet_observed, narr: $partial_narrative, dedupe: true, mod: $module_name, phase: :receive_response_headers

template :otlp_partial_success_path
|> window :default_5s
|> use :otlp_partial_success_rules
