# gewyvern stable-subset protocol path

fn memcached_not_stored_rules() =
  let module_name = :memcached_not_stored_path
  let route_narrative = "static:program resolved an upstream route for this Memcached not-stored path"
  let not_stored_narrative = "static:observed a Memcached binary SET NOT_STORED response"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :memcached_not_stored
  |> reason_model :memcached_not_stored_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:memcached", stage: :socket_state_transition, narr: "static:program initiated or advanced a Memcached socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:memcached:established", stage: :socket_state_transition, narr: "static:program reached an established Memcached socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x01:byte_at:6:0xff:0x00:byte_at:7:0xff:0x05", stage: :packet_observed, narr: $not_stored_narrative, dedupe: true, mod: $module_name, phase: :receive_not_stored
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:memcached", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:memcached:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x01:byte_at:6:0xff:0x00:byte_at:7:0xff:0x05", event: :packet_observed, narr: $not_stored_narrative, dedupe: true, mod: $module_name, phase: :receive_not_stored

template :memcached_not_stored_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :memcached_not_stored_rules
|> param :sock_lineage_fragment.capture_comm, true
