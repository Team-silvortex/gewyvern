# gewyvern stable-subset protocol path

fn mssql_colmetadata_rules() =
  let module_name = :mssql_colmetadata_path
  let metadata_narrative = "static:observed a TDS COLMETADATA token from SQL Server"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:mssql_colmetadata)
  |> reason_model(:mssql_colmetadata_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> program_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0x81", stage: :packet_observed, narrative: ${metadata_narrative}, dedupe: true, module: ${module_name}, phase: :receive_colmetadata)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_server)
  |> reason_rule(predicate: "packet_observed:tcp:remote:1433:remote_to_local:byte0_mask:0xff:0x04:byte_at:8:0xff:0x81", key_event: :packet_observed, narrative: ${metadata_narrative}, dedupe: true, module: ${module_name}, phase: :receive_colmetadata)

template(:mssql_colmetadata_path)
|> window(:default_5s)
|> use(:mssql_colmetadata_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
