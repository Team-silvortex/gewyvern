# gewyvern DSL v0
template=memcached_get_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=memcached_get_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=memcached_get
rule=process_bound;process_bound;process_bound;true;memcached_get_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this Memcached GET path;true;memcached_get_path;resolve_upstream
rule=socket_state_observed:remote:memcached;socket_state_transition;static:program initiated or advanced a Memcached socket state transition;false;memcached_get_path;connect
rule=socket_state_observed:remote:memcached:established;socket_state_transition;static:program reached an established Memcached socket state;true;memcached_get_path;establish
rule=packet_observed:tcp:remote:memcached:local_to_remote:byte0_mask:0xff:0x80:byte_at:1:0xff:0x00;packet_observed;transport_payload_sent;true;memcached_get_path;send_get
rule=packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x00;packet_observed;transport_payload_received;true;memcached_get_path;receive_value
reason.rule=process_bound;process_identified;process_bound;true;memcached_get_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;memcached_get_path;resolve_upstream
reason.rule=socket_state_observed:remote:memcached;state_change;tcp_state_transition;false;memcached_get_path;connect
reason.rule=socket_state_observed:remote:memcached:established;state_change;tcp_state_transition;true;memcached_get_path;establish
reason.rule=packet_observed:tcp:remote:memcached:local_to_remote:byte0_mask:0xff:0x80:byte_at:1:0xff:0x00;packet_observed;transport_payload_sent;true;memcached_get_path;send_get
reason.rule=packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x00;packet_observed;transport_payload_received;true;memcached_get_path;receive_value
param=sock_lineage_fragment.capture_comm=true
