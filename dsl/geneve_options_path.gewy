# gewyvern stable-subset protocol path

fn geneve_options_rules() =
  let module_name = :geneve_options_path
  let options_narrative = "static:observed a GENEVE packet carrying option metadata"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> operation(:geneve_options)
  |> reason_model(:geneve_options_path_reason)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_overlay)
  |> program_rule(predicate: "datagram_observed:udp:remote:geneve:local_to_remote:byte0_mask:0x3f:0x04", stage: :datagram_observed, narrative: ${options_narrative}, dedupe: true, module: ${module_name}, phase: :send_optioned_packet)
  |> program_rule(predicate: "datagram_observed:udp:remote:geneve:remote_to_local:byte0_mask:0x3f:0x04", stage: :datagram_observed, narrative: ${options_narrative}, dedupe: true, module: ${module_name}, phase: :receive_optioned_packet)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_overlay)
  |> reason_rule(predicate: "datagram_observed:udp:remote:geneve:local_to_remote:byte0_mask:0x3f:0x04", key_event: :udp_datagram_seen, narrative: ${options_narrative}, dedupe: true, module: ${module_name}, phase: :send_optioned_packet)
  |> reason_rule(predicate: "datagram_observed:udp:remote:geneve:remote_to_local:byte0_mask:0x3f:0x04", key_event: :udp_datagram_seen, narrative: ${options_narrative}, dedupe: true, module: ${module_name}, phase: :receive_optioned_packet)

template(:geneve_options_path)
|> window(:default_5s)
|> use(:geneve_options_rules)
