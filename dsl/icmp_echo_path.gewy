# gewyvern stable-subset protocol path

fn icmp_echo_rules() =
  let module_name = :icmp_echo_path
  let route_narrative = "static:program resolved a route before ICMP echo probing"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:icmp_echo)
  |> reason_model(:icmp_echo_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> program_rule(predicate: "packet_observed:1:local_to_remote:byte0_mask:0xff:0x08", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_echo_request)
  |> program_rule(predicate: "packet_observed:1:remote_to_local:byte0_mask:0xff:0x00", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_echo_reply)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_peer)
  |> reason_rule(predicate: "packet_observed:1:local_to_remote:byte0_mask:0xff:0x08", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_echo_request)
  |> reason_rule(predicate: "packet_observed:1:remote_to_local:byte0_mask:0xff:0x00", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_echo_reply)

template(:icmp_echo_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:icmp_echo_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
