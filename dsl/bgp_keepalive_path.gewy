# gewyvern stable-subset protocol path

fn bgp_keepalive_rules() =
  let module_name = :bgp_keepalive_path
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :sock_lineage_fragment
  |> param :tcp_packet_meta_fragment.sample_payload_offsets, 18
  |> operation :bgp_keepalive
  |> reason_model :bgp_keepalive_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:bgp:established", stage: :socket_state_transition, narr: "static:program reached an established BGP TCP session", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x04", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_keepalive
  |> program_rule pred: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x04", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_keepalive
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:bgp:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x04", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_keepalive
  |> reason_rule pred: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x04", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_keepalive

template :bgp_keepalive_path
|> window :default_5s
|> use :bgp_keepalive_rules
