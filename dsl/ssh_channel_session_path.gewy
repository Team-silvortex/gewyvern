# gewyvern stable-subset protocol path

fn ssh_channel_session_rules() =
  let module_name = :ssh_channel_session_path
  let route_narrative = "static:program resolved an upstream route for this SSH channel session"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :ssh_channel_session
  |> reason_model :ssh_channel_session_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:ssh", stage: :socket_state_transition, narr: "static:program initiated or advanced an SSH socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_server_banner
  |> program_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_client_banner
  |> program_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_key_exchange_init
  |> program_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x32", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> program_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:byte_at:5:0xff:0x34", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_success
  |> program_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x5a", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_channel_open
  |> program_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:byte_at:5:0xff:0x5b", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_channel_open_confirmation
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:ssh", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_server_banner
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_client_banner
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_key_exchange_init
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x32", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:byte_at:5:0xff:0x34", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_success
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x5a", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_channel_open
  |> reason_rule pred: "packet_observed:tcp:remote:ssh:remote_to_local:byte_at:5:0xff:0x5b", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_channel_open_confirmation

template :ssh_channel_session_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :ssh_channel_session_rules
|> param :sock_lineage_fragment.capture_comm, true
