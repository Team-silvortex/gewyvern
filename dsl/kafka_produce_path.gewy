# gewyvern stable-subset protocol path

fn kafka_produce_rules() =
  let module_name = :kafka_produce_path
  let produce_narrative = "static:observed a Kafka Produce request or response on TCP port 9092"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> operation(:kafka_produce)
  |> reason_model(:kafka_produce_path_reason)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_broker)
  |> program_rule(predicate: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x00", stage: :packet_observed, narrative: ${produce_narrative}, dedupe: true, module: ${module_name}, phase: :send_produce_request)
  |> program_rule(predicate: "packet_observed:tcp:remote:kafka:remote_to_local", stage: :packet_observed, narrative: ${produce_narrative}, dedupe: true, module: ${module_name}, phase: :receive_produce_response)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_broker)
  |> reason_rule(predicate: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x00", key_event: :packet_observed, narrative: ${produce_narrative}, dedupe: true, module: ${module_name}, phase: :send_produce_request)
  |> reason_rule(predicate: "packet_observed:tcp:remote:kafka:remote_to_local", key_event: :packet_observed, narrative: ${produce_narrative}, dedupe: true, module: ${module_name}, phase: :receive_produce_response)

template(:kafka_produce_path)
|> window(:default_5s)
|> use(:kafka_produce_rules)
