# gewyvern DSL v0
template=handshake_debug
window.duration_ms=5000
window.lateness_ms=200
reason=handshake_l1
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
operation=connect_flow
rule=process_bound;process_bound;process_bound;true
rule=socket_state_observed;socket_state_transition;none;false
rule=route_resolved;route_resolved;static:program resolved a route for this network flow;true
