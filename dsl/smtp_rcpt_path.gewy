# gewyvern DSL v0
template=smtp_rcpt_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=smtp_rcpt_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=smtp_rcpt
rule=process_bound;process_bound;process_bound;true;smtp_rcpt_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this SMTP recipient session;true;smtp_rcpt_path;resolve_upstream
rule=socket_state_observed:remote:smtp;socket_state_transition;static:program initiated or advanced an SMTP socket state transition;false;smtp_rcpt_path;connect
rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32323020;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_banner
rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x45484c4f;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_ehlo
rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32353020;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_ehlo_ok
rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x41555448;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_auth_request
rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32333520;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_auth_ok
rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x4d41494c;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_mail_from
rule=packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_mail_ok
rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x52435054;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_rcpt_to
rule=packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e,0x35;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_rcpt_ok
reason.rule=process_bound;process_identified;process_bound;true;smtp_rcpt_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;smtp_rcpt_path;resolve_upstream
reason.rule=socket_state_observed:remote:smtp;state_change;tcp_state_transition;false;smtp_rcpt_path;connect
reason.rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32323020;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_banner
reason.rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x45484c4f;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_ehlo
reason.rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32353020;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_ehlo_ok
reason.rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x41555448;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_auth_request
reason.rule=packet_observed:tcp:remote:smtp:remote_to_local:prefix4:0x32333520;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_auth_ok
reason.rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x4d41494c;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_mail_from
reason.rule=packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_mail_ok
reason.rule=packet_observed:tcp:remote:smtp:local_to_remote:prefix4:0x52435054;packet_observed;transport_payload_sent;true;smtp_rcpt_path;send_rcpt_to
reason.rule=packet_observed:tcp:remote:smtp:remote_to_local:bytes_at:0:0x32,0x35,0x30,0x20,0x32,0x2e,0x31,0x2e,0x35;packet_observed;transport_payload_received;true;smtp_rcpt_path;receive_rcpt_ok
param=sock_lineage_fragment.capture_comm=true
