# gewyvern DSL v0
template=dns_udp_process
window.duration_ms=5000
window.lateness_ms=200
reason_model=dns_udp_process_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=dns_lookup
rule=process_bound;process_bound;process_bound;true;dns_lookup_path
rule=datagram_observed:udp:egress;datagram_observed;static:program emitted a DNS request datagram;true;dns_lookup_path
rule=route_resolved;route_resolved;static:program resolved an upstream route for this DNS lookup;true;dns_lookup_path
reason.rule=process_bound;process_identified;process_bound;true;dns_lookup_path
reason.rule=datagram_observed:udp:egress;udp_datagram_seen;static:dns request datagram observed;true;dns_lookup_path
reason.rule=route_resolved;route_changed;route_changed;true;dns_lookup_path
param=sock_lineage_fragment.capture_comm=true
