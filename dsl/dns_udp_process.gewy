# gewyvern stable-subset protocol path

fn dns_udp_process_rules() =
  let module_name = :dns_lookup_path
  let route_narrative = "static:program resolved an upstream route for this DNS lookup"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:dns_lookup)
  |> reason_model(:dns_udp_process_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve)
  |> program_rule(predicate: "datagram_observed:udp:local_to_remote", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)
  |> program_rule(predicate: "datagram_observed:udp:remote_to_local", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_reply)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve)
  |> reason_rule(predicate: "datagram_observed:udp:local_to_remote", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote_to_local", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_reply)

template(:dns_udp_process)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:dns_udp_process_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
