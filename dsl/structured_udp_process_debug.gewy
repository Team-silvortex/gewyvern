# gewyvern stable-subset baseline

fn structured_udp_process_rules() =
  let module_name = :structured_udp_process_debug
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :datagram_exchange
  |> program_model :structured_udp_process_debug_model
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "datagram_observed:udp", stage: :datagram_observed, narr: :udp_datagram_observed, dedupe: true, mod: $module_name, phase: :observe_datagram
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_route

template :structured_udp_process_debug
|> window :default_5s
|> reason :udp_datagram_l1
|> use :structured_udp_process_rules
