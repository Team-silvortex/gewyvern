# gewyvern DSL v0
template=gtpu_echo_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=gtpu_echo_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=gtpu_echo
rule=process_bound;process_bound;process_bound;true;gtpu_echo_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this GTP-U echo path;true;gtpu_echo_path;resolve_upstream
rule=datagram_observed:udp:remote:gtpu:local_to_remote:prefix2:0x3001;datagram_observed;udp_datagram_sent;true;gtpu_echo_path;send_echo_request
rule=datagram_observed:udp:remote:gtpu:remote_to_local:prefix2:0x3002;datagram_observed;udp_datagram_received;true;gtpu_echo_path;receive_echo_response
reason.rule=process_bound;process_identified;process_bound;true;gtpu_echo_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;gtpu_echo_path;resolve_upstream
reason.rule=datagram_observed:udp:remote:gtpu:local_to_remote:prefix2:0x3001;udp_datagram_seen;udp_datagram_sent;true;gtpu_echo_path;send_echo_request
reason.rule=datagram_observed:udp:remote:gtpu:remote_to_local:prefix2:0x3002;udp_datagram_seen;udp_datagram_received;true;gtpu_echo_path;receive_echo_response
param=sock_lineage_fragment.capture_comm=true
