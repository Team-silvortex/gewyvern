# gewyvern stable-subset protocol path

fn http_connect_tunnel_rules() =
  let module_name = :http_connect_tunnel_path
  let route_narrative = "static:program resolved an upstream route for this HTTP CONNECT tunnel path"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :http_connect_tunnel
  |> reason_model :http_connect_tunnel_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:8080", stage: :socket_state_transition, narr: "static:program initiated or advanced an HTTP proxy socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:8080:local_to_remote:prefix4:0x434f4e4e", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect_request
  |> program_rule pred: "packet_observed:tcp:remote:8080:remote_to_local:prefix4:0x32303020", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connect_established
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:8080", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:8080:local_to_remote:prefix4:0x434f4e4e", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_connect_request
  |> reason_rule pred: "packet_observed:tcp:remote:8080:remote_to_local:prefix4:0x32303020", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_connect_established

template :http_connect_tunnel_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :http_connect_tunnel_rules
|> param :sock_lineage_fragment.capture_comm, true
