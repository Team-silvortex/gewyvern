# gewyvern DSL v0
template=http_connect_tunnel_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=http_connect_tunnel_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=http_connect_tunnel
rule=process_bound;process_bound;process_bound;true;http_connect_tunnel_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this HTTP CONNECT tunnel path;true;http_connect_tunnel_path;resolve_upstream
rule=socket_state_observed:remote:8080;socket_state_transition;static:program initiated or advanced an HTTP proxy socket state transition;false;http_connect_tunnel_path;connect
rule=packet_observed:tcp:remote:8080:local_to_remote:prefix4:0x434f4e4e;packet_observed;transport_payload_sent;true;http_connect_tunnel_path;send_connect_request
rule=packet_observed:tcp:remote:8080:remote_to_local:prefix4:0x32303020;packet_observed;transport_payload_received;true;http_connect_tunnel_path;receive_connect_established
reason.rule=process_bound;process_identified;process_bound;true;http_connect_tunnel_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;http_connect_tunnel_path;resolve_upstream
reason.rule=socket_state_observed:remote:8080;state_change;tcp_state_transition;false;http_connect_tunnel_path;connect
reason.rule=packet_observed:tcp:remote:8080:local_to_remote:prefix4:0x434f4e4e;packet_observed;transport_payload_sent;true;http_connect_tunnel_path;send_connect_request
reason.rule=packet_observed:tcp:remote:8080:remote_to_local:prefix4:0x32303020;packet_observed;transport_payload_received;true;http_connect_tunnel_path;receive_connect_established
param=sock_lineage_fragment.capture_comm=true
