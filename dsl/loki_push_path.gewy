# gewyvern stable-subset protocol path

fn loki_push_rules() =
  let module_name = :loki_push_path
  let push_narrative = "static:observed a Loki log push request"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:loki_push)
  |> reason_model(:loki_push_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_loki)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", stage: :packet_observed, narrative: ${push_narrative}, dedupe: true, module: ${module_name}, phase: :send_log_batch)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_push_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_loki)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", key_event: :packet_observed, narrative: ${push_narrative}, dedupe: true, module: ${module_name}, phase: :send_log_batch)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_push_response)

template(:loki_push_path)
|> window(duration_ms: 10000, lateness_ms: 300)
|> use(:loki_push_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
