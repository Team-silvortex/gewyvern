# gewyvern stable-subset protocol path

fn dhcp_nak_rules() =
  let module_name = :dhcp_nak_path
  let route_narrative = "static:program resolved an upstream route for this DHCP rejection path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:dhcp_nak)
  |> reason_model(:dhcp_nak_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:local:dhcp_client:remote:dhcp_server:local_to_remote:byte0_mask:0xff:0x01:byte_at:242:0xff:0x03", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)
  |> program_rule(predicate: "datagram_observed:udp:local:dhcp_client:remote:dhcp_server:remote_to_local:byte0_mask:0xff:0x02:byte_at:242:0xff:0x06", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_nak)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:local:dhcp_client:remote:dhcp_server:local_to_remote:byte0_mask:0xff:0x01:byte_at:242:0xff:0x03", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)
  |> reason_rule(predicate: "datagram_observed:udp:local:dhcp_client:remote:dhcp_server:remote_to_local:byte0_mask:0xff:0x02:byte_at:242:0xff:0x06", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_nak)

template(:dhcp_nak_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:dhcp_nak_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
