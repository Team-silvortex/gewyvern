# gewyvern stable-subset protocol path

fn consul_kv_rules() =
  let module_name = :consul_kv_path
  let get_narrative = "static:observed a Consul KV read request"
  let put_narrative = "static:observed a Consul KV write request"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:consul_kv)
  |> reason_model(:consul_kv_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_agent)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", stage: :packet_observed, narrative: ${get_narrative}, dedupe: true, module: ${module_name}, phase: :send_kv_get)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", stage: :packet_observed, narrative: ${put_narrative}, dedupe: true, module: ${module_name}, phase: :send_kv_put)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_kv)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_agent)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", key_event: :packet_observed, narrative: ${get_narrative}, dedupe: true, module: ${module_name}, phase: :send_kv_get)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", key_event: :packet_observed, narrative: ${put_narrative}, dedupe: true, module: ${module_name}, phase: :send_kv_put)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_kv)

template(:consul_kv_path)
|> window(:default_5s)
|> use(:consul_kv_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
