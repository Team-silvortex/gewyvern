# gewyvern DSL v0
template=http_request_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=http_request_path_reason
fragment=udp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=http_request
rule=process_bound;process_bound;process_bound;true;http_request_path;bind
rule=datagram_observed:udp:egress;datagram_observed;static:program emitted a DNS request datagram;true;http_request_path;resolve_dns_request
rule=datagram_observed:udp:ingress;datagram_observed;static:program observed a DNS reply datagram;true;http_request_path;resolve_dns_reply
rule=route_resolved;route_resolved;static:program resolved an upstream route for this HTTP request path;true;http_request_path;resolve_upstream
rule=socket_state_observed:https;socket_state_transition;static:program initiated or advanced an HTTPS connect path;false;http_request_path;connect
rule=socket_state_observed:https:established;socket_state_transition;static:program reached an established HTTPS socket state;true;http_request_path;establish
reason.rule=process_bound;process_identified;process_bound;true;http_request_path;bind
reason.rule=datagram_observed:udp:egress;udp_datagram_seen;static:dns request datagram observed;true;http_request_path;resolve_dns_request
reason.rule=datagram_observed:udp:ingress;udp_datagram_seen;static:dns reply datagram observed;true;http_request_path;resolve_dns_reply
reason.rule=route_resolved;route_changed;route_changed;true;http_request_path;resolve_upstream
reason.rule=socket_state_observed:https;state_change;tcp_state_transition;false;http_request_path;connect
reason.rule=socket_state_observed:https:established;state_change;tcp_state_transition;true;http_request_path;establish
param=sock_lineage_fragment.capture_comm=true
