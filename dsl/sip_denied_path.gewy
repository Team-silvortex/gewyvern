# gewyvern stable-subset protocol path

fn sip_denied_rules() =
  let module_name = :sip_denied_path
  let route_narrative = "static:program resolved a route for this SIP denied response path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :sip_denied
  |> reason_model :sip_denied_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> program_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x34", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_4xx
  |> program_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x35", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_5xx
  |> program_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x36", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_6xx
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> reason_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x34", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_4xx
  |> reason_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x35", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_5xx
  |> reason_rule pred: "datagram_observed:udp:remote:sip:remote_to_local:byte_at:8:0xff:0x36", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_6xx

template :sip_denied_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :sip_denied_rules
|> param :udp_packet_meta_fragment.sample_payload_offsets, 8
|> param :sock_lineage_fragment.capture_comm, true
