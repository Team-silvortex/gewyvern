# gewyvern stable-subset protocol path

fn redis_zmpop_rules() =
  let module_name = :redis_zmpop_path
  let route_narrative = "static:program resolved an upstream route for this Redis ZMPOP path"
  |> fragment(:tcp_packet_meta_fragment)
  |> param(:tcp_packet_meta_fragment.sample_payload_offsets, "8,11,12")
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> program_model(:redis_zmpop_path_model)
  |> operation(:redis_zmpop)
  |> reason_model(:redis_zmpop_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: "socket_state_observed:remote:redis", stage: :socket_state_transition, narrative: "static:program initiated or advanced a Redis socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "socket_state_observed:remote:redis:established", stage: :socket_state_transition, narrative: "static:program reached an established Redis socket state", dedupe: true, module: ${module_name}, phase: :establish)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a340d0a:byte_at:5:0xff:0x35:byte_at:8:0xff:0x5a:byte_at:9:0xff:0x4d:byte_at:10:0xff:0x50:byte_at:11:0xff:0x4f:byte_at:12:0xff:0x50", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_zmpop)
  |> program_rule(predicate: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x2a", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_array)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: "socket_state_observed:remote:redis", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "socket_state_observed:remote:redis:established", key_event: :state_change, narrative: :tcp_state_transition, dedupe: true, module: ${module_name}, phase: :establish)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "packet_observed:tcp:remote:redis:local_to_remote:prefix4:0x2a340d0a:byte_at:5:0xff:0x35:byte_at:8:0xff:0x5a:byte_at:9:0xff:0x4d:byte_at:10:0xff:0x50:byte_at:11:0xff:0x4f:byte_at:12:0xff:0x50", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_zmpop)
  |> reason_rule(predicate: "packet_observed:tcp:remote:redis:remote_to_local:byte0_mask:0xff:0x2a", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_array)

template(:redis_zmpop_path)
|> window(:default_5s)
|> use(:redis_zmpop_rules)
