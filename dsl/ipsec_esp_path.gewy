# gewyvern stable-subset protocol path

fn ipsec_esp_rules() =
  let module_name = :ipsec_esp_path
  let esp_narrative = "static:observed an IPsec ESP packet on IP protocol 50"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :ipsec_esp
  |> reason_model :ipsec_esp_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_secure_path
  |> program_rule pred: "packet_observed:50:local_to_remote", stage: :packet_observed, narr: $esp_narrative, dedupe: true, mod: $module_name, phase: :send_esp_packet
  |> program_rule pred: "packet_observed:50:remote_to_local", stage: :packet_observed, narr: $esp_narrative, dedupe: true, mod: $module_name, phase: :receive_esp_packet
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_secure_path
  |> reason_rule pred: "packet_observed:50:local_to_remote", event: :packet_observed, narr: $esp_narrative, dedupe: true, mod: $module_name, phase: :send_esp_packet
  |> reason_rule pred: "packet_observed:50:remote_to_local", event: :packet_observed, narr: $esp_narrative, dedupe: true, mod: $module_name, phase: :receive_esp_packet

template :ipsec_esp_path
|> window :default_5s
|> use :ipsec_esp_rules

