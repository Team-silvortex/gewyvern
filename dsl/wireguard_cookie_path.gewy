# gewyvern stable-subset protocol path

fn wireguard_cookie_rules() =
  let module_name = :wireguard_cookie_path
  let route_narrative = "static:program resolved an upstream route for this WireGuard cookie path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :wireguard_cookie
  |> reason_model :wireguard_cookie_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:remote:wireguard:local_to_remote:byte0_mask:0xff:0x01", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_initiation
  |> program_rule pred: "datagram_observed:udp:remote:wireguard:remote_to_local:byte0_mask:0xff:0x03", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_cookie_reply
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:remote:wireguard:local_to_remote:byte0_mask:0xff:0x01", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_initiation
  |> reason_rule pred: "datagram_observed:udp:remote:wireguard:remote_to_local:byte0_mask:0xff:0x03", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_cookie_reply

template :wireguard_cookie_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :wireguard_cookie_rules
|> param :sock_lineage_fragment.capture_comm, true
