# gewyvern stable-subset protocol path

fn elasticsearch_search_rules() =
  let module_name = :elasticsearch_search_path
  let get_narrative = "static:observed an Elasticsearch-compatible search GET request"
  let post_narrative = "static:observed an Elasticsearch-compatible search POST request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :elasticsearch_search
  |> reason_model :elasticsearch_search_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", stage: :packet_observed, narr: $get_narrative, dedupe: true, mod: $module_name, phase: :send_search_get
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", stage: :packet_observed, narr: $post_narrative, dedupe: true, mod: $module_name, phase: :send_search_post
  |> program_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", event: :packet_observed, narr: $get_narrative, dedupe: true, mod: $module_name, phase: :send_search_get
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", event: :packet_observed, narr: $post_narrative, dedupe: true, mod: $module_name, phase: :send_search_post
  |> reason_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response

template :elasticsearch_search_path
|> window :default_5s
|> use :elasticsearch_search_rules
|> param :sock_lineage_fragment.capture_comm, true
