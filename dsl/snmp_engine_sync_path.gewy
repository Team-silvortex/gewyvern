# gewyvern stable-subset protocol path

fn snmp_engine_sync_rules() =
  let module_name = :snmp_engine_sync_path
  let route_narrative = "static:program resolved an upstream route for this SNMP engine sync path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:snmp_engine_sync)
  |> reason_model(:snmp_engine_sync_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa0:byte_at:18:0xff:0x04", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_engine_sync_probe)
  |> program_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa8:byte_at:18:0xff:0x04", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_engine_sync_report)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:snmp:local_to_remote:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa0:byte_at:18:0xff:0x04", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_engine_sync_probe)
  |> reason_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa8:byte_at:18:0xff:0x04", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_engine_sync_report)

template(:snmp_engine_sync_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:snmp_engine_sync_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
