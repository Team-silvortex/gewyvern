# gewyvern stable-subset protocol path

fn pptp_data_rules() =
  let module_name = :pptp_data_path
  let data_narrative = "static:observed a PPTP GRE data packet on IP protocol 47"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> operation :pptp_data
  |> reason_model :pptp_data_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_tunnel
  |> program_rule pred: "packet_observed:47:local_to_remote", stage: :packet_observed, narr: $data_narrative, dedupe: true, mod: $module_name, phase: :send_gre_data
  |> program_rule pred: "packet_observed:47:remote_to_local", stage: :packet_observed, narr: $data_narrative, dedupe: true, mod: $module_name, phase: :receive_gre_data
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_tunnel
  |> reason_rule pred: "packet_observed:47:local_to_remote", event: :packet_observed, narr: $data_narrative, dedupe: true, mod: $module_name, phase: :send_gre_data
  |> reason_rule pred: "packet_observed:47:remote_to_local", event: :packet_observed, narr: $data_narrative, dedupe: true, mod: $module_name, phase: :receive_gre_data

template :pptp_data_path
|> window :default_5s
|> use :pptp_data_rules
