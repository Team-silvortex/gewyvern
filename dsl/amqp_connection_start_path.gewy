# gewyvern DSL v0
template=amqp_connection_start_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=amqp_connection_start_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=amqp_connection_start
rule=process_bound;process_bound;process_bound;true;amqp_connection_start_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this AMQP connection start path;true;amqp_connection_start_path;resolve_upstream
rule=socket_state_observed:remote:amqp;socket_state_transition;static:program initiated or advanced an AMQP socket state transition;false;amqp_connection_start_path;connect
rule=socket_state_observed:remote:amqp:established;socket_state_transition;static:program reached an established AMQP socket state;true;amqp_connection_start_path;establish
rule=packet_observed:tcp:remote:amqp:local_to_remote:prefix4:0x414d5150;packet_observed;transport_payload_sent;true;amqp_connection_start_path;send_protocol_header
rule=packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0a;packet_observed;transport_payload_received;true;amqp_connection_start_path;receive_start
rule=packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0b;packet_observed;transport_payload_sent;true;amqp_connection_start_path;send_start_ok
reason.rule=process_bound;process_identified;process_bound;true;amqp_connection_start_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;amqp_connection_start_path;resolve_upstream
reason.rule=socket_state_observed:remote:amqp;state_change;tcp_state_transition;false;amqp_connection_start_path;connect
reason.rule=socket_state_observed:remote:amqp:established;state_change;tcp_state_transition;true;amqp_connection_start_path;establish
reason.rule=packet_observed:tcp:remote:amqp:local_to_remote:prefix4:0x414d5150;packet_observed;transport_payload_sent;true;amqp_connection_start_path;send_protocol_header
reason.rule=packet_observed:tcp:remote:amqp:remote_to_local:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0a;packet_observed;transport_payload_received;true;amqp_connection_start_path;receive_start
reason.rule=packet_observed:tcp:remote:amqp:local_to_remote:byte0_mask:0xff:0x01:byte_at:10:0xff:0x0b;packet_observed;transport_payload_sent;true;amqp_connection_start_path;send_start_ok
param=sock_lineage_fragment.capture_comm=true
