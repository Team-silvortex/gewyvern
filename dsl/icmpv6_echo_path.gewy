# gewyvern stable-subset protocol path

fn icmpv6_echo_rules() =
  let module_name = :icmpv6_echo_path
  let route_narrative = "static:program resolved a route before ICMPv6 echo probing"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :icmpv6_echo
  |> reason_model :icmpv6_echo_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> program_rule pred: "packet_observed:58:local_to_remote:byte0_mask:0xff:0x80", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_echo_request
  |> program_rule pred: "packet_observed:58:remote_to_local:byte0_mask:0xff:0x81", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_echo_reply
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> reason_rule pred: "packet_observed:58:local_to_remote:byte0_mask:0xff:0x80", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_echo_request
  |> reason_rule pred: "packet_observed:58:remote_to_local:byte0_mask:0xff:0x81", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_echo_reply

template :icmpv6_echo_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :icmpv6_echo_rules
|> param :sock_lineage_fragment.capture_comm, true
