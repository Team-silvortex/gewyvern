template=ldap_bind_path
window=default_5s
reason_model=ldap_bind_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=ldap_bind_path_model
operation=ldap_bind
rule=process_bound;process_bound;process_bound;true;ldap_bind_path;bind
rule=socket_state_observed:remote:ldap;socket_state_transition;static:program initiated or advanced an LDAP socket state transition;false;ldap_bind_path;connect
rule=socket_state_observed:remote:ldap:established;socket_state_transition;static:program reached an established LDAP socket state;true;ldap_bind_path;establish
rule=route_resolved;route_resolved;static:program resolved an upstream route for this LDAP bind path;true;ldap_bind_path;resolve_upstream
rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60;packet_observed;transport_payload_sent;true;ldap_bind_path;send_bind
rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61;packet_observed;transport_payload_received;true;ldap_bind_path;receive_bind_response
reason.rule=process_bound;process_identified;process_bound;true;ldap_bind_path;bind
reason.rule=socket_state_observed:remote:ldap;state_change;tcp_state_transition;false;ldap_bind_path;connect
reason.rule=socket_state_observed:remote:ldap:established;state_change;tcp_state_transition;true;ldap_bind_path;establish
reason.rule=route_resolved;route_changed;route_changed;true;ldap_bind_path;resolve_upstream
reason.rule=packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x60;packet_observed;transport_payload_sent;true;ldap_bind_path;send_bind
reason.rule=packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x61;packet_observed;transport_payload_received;true;ldap_bind_path;receive_bind_response
