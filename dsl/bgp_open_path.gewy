# gewyvern stable-subset protocol path

fn bgp_open_rules() =
  let module_name = :bgp_open_path
  let route_narrative = "static:program resolved a route before opening a BGP peer session"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> param :tcp_packet_meta_fragment.sample_payload_offsets, 18
  |> operation :bgp_open
  |> reason_model :bgp_open_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:bgp", stage: :socket_state_transition, narr: "static:program initiated or advanced a BGP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:bgp:established", stage: :socket_state_transition, narr: "static:program reached an established BGP TCP session", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> program_rule pred: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x01", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_open
  |> program_rule pred: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x01", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_open
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:bgp", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:bgp:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_peer
  |> reason_rule pred: "packet_observed:tcp:remote:bgp:local_to_remote:byte_at:18:0xff:0x01", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_open
  |> reason_rule pred: "packet_observed:tcp:remote:bgp:remote_to_local:byte_at:18:0xff:0x01", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_open

template :bgp_open_path
|> window :default_5s
|> use :bgp_open_rules
