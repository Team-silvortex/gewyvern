# gewyvern stable-subset protocol path

fn elasticsearch_index_rules() =
  let module_name = :elasticsearch_index_path
  let put_narrative = "static:observed an Elasticsearch-compatible document index PUT request"
  let post_narrative = "static:observed an Elasticsearch-compatible document index POST request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :elasticsearch_index
  |> reason_model :elasticsearch_index_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", stage: :packet_observed, narr: $put_narrative, dedupe: true, mod: $module_name, phase: :send_index_put
  |> program_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", stage: :packet_observed, narr: $post_narrative, dedupe: true, mod: $module_name, phase: :send_index_post
  |> program_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_cluster
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x50555420", event: :packet_observed, narr: $put_narrative, dedupe: true, mod: $module_name, phase: :send_index_put
  |> reason_rule pred: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x504f5354", event: :packet_observed, narr: $post_narrative, dedupe: true, mod: $module_name, phase: :send_index_post
  |> reason_rule pred: "packet_observed:tcp:remote:http:remote_to_local:prefix4:0x48545450", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_response

template :elasticsearch_index_path
|> window :default_5s
|> use :elasticsearch_index_rules
|> param :sock_lineage_fragment.capture_comm, true
