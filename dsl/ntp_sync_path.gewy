# gewyvern stable-subset protocol path

fn ntp_sync_rules() =
  let module_name = :ntp_sync_path
  let route_narrative = "static:program resolved an upstream route for this NTP sync path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:ntp_sync)
  |> reason_model(:ntp_sync_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:ntp:local_to_remote:byte0_mask:0xff:0x1b", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_sync_request)
  |> program_rule(predicate: "datagram_observed:udp:remote:ntp:remote_to_local:byte0_mask:0xff:0x24", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_sync_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:ntp:local_to_remote:byte0_mask:0xff:0x1b", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_sync_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote:ntp:remote_to_local:byte0_mask:0xff:0x24", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_sync_response)

template(:ntp_sync_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:ntp_sync_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
