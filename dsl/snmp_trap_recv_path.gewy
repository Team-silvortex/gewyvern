# gewyvern stable-subset protocol path

fn snmp_trap_recv_rules() =
  let module_name = :snmp_trap_recv_path
  let route_narrative = "static:program resolved a local trap receive route for this SNMP path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :snmp_trap_recv
  |> reason_model :snmp_trap_recv_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_listener
  |> program_rule pred: "datagram_observed:udp:local:snmp_trap:remote_to_local:byte0_mask:0xff:0x30:byte_at:13:0xff:0xa7", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_trap_notification
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_listener
  |> reason_rule pred: "datagram_observed:udp:local:snmp_trap:remote_to_local:byte0_mask:0xff:0x30:byte_at:13:0xff:0xa7", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_trap_notification

template :snmp_trap_recv_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :snmp_trap_recv_rules
|> param :sock_lineage_fragment.capture_comm, true
