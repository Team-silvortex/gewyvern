# gewyvern stable-subset protocol path

fn hy2_udp_relay_rules() =
  let module_name = :hy2_udp_relay_path
  let route_narrative = "static:program resolved an upstream route for this Hysteria 2 UDP relay path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :hy2_udp_relay
  |> reason_model :hy2_udp_relay_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "quic_packet_observed:remote:hy2:local_to_remote:min_len:1200:long_header:true:type:initial", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_initial
  |> program_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:type:initial:frame:crypto", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_crypto
  |> program_rule pred: "quic_packet_observed:remote:hy2:remote_to_local:long_header:true:type:handshake", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_handshake
  |> program_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:type:handshake:frame:crypto", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_crypto
  |> program_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:frame:stream", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request_stream
  |> program_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:frame:stream", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok_stream
  |> program_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:frame:datagram", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_udp_relay_datagram
  |> program_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:frame:datagram", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_udp_relay_datagram
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "quic_packet_observed:remote:hy2:local_to_remote:min_len:1200:long_header:true:type:initial", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_initial
  |> reason_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:type:initial:frame:crypto", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_crypto
  |> reason_rule pred: "quic_packet_observed:remote:hy2:remote_to_local:long_header:true:type:handshake", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_handshake
  |> reason_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:type:handshake:frame:crypto", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_crypto
  |> reason_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:frame:stream", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request_stream
  |> reason_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:frame:stream", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok_stream
  |> reason_rule pred: "quic_frame_observed:remote:hy2:local_to_remote:frame:datagram", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_udp_relay_datagram
  |> reason_rule pred: "quic_frame_observed:remote:hy2:remote_to_local:frame:datagram", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_udp_relay_datagram

template :hy2_udp_relay_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :hy2_udp_relay_rules
|> param :sock_lineage_fragment.capture_comm, true
