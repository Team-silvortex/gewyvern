# gewyvern stable-subset protocol path

fn https_connect_rules() =
  let module_name = :https_connect_path
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :https_connect
  |> reason_model :https_connect_process_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:https", stage: :socket_state_transition, narr: "static:program initiated or advanced an HTTPS socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: "static:program resolved an upstream route for this HTTPS connect path", dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:https", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream

template :https_connect_process
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :https_connect_rules
|> param :sock_lineage_fragment.capture_comm, true
