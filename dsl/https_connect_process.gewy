# gewyvern stable-subset protocol path

fn https_connect_rules() =
  let module_name = :https_connect_path
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:https_connect)
  |> reason_model(:https_connect_process_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: "socket_state_observed:remote:https", stage: :socket_state_transition, narrative: "static:program initiated or advanced an HTTPS socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: "static:program resolved an upstream route for this HTTPS connect path", dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: "socket_state_observed:remote:https", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)

template(:https_connect_process)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:https_connect_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
