# gewyvern stable-subset protocol path

fn kafka_metadata_rules() =
  let module_name = :kafka_metadata_path
  let metadata_narrative = "static:observed a Kafka Metadata request or response on TCP port 9092"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> operation :kafka_metadata
  |> reason_model :kafka_metadata_path_reason
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_broker
  |> program_rule pred: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x03", stage: :packet_observed, narr: $metadata_narrative, dedupe: true, mod: $module_name, phase: :send_metadata_request
  |> program_rule pred: "packet_observed:tcp:remote:kafka:remote_to_local", stage: :packet_observed, narr: $metadata_narrative, dedupe: true, mod: $module_name, phase: :receive_metadata_response
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_broker
  |> reason_rule pred: "packet_observed:tcp:remote:kafka:local_to_remote:byte_at:5:0xff:0x03", event: :packet_observed, narr: $metadata_narrative, dedupe: true, mod: $module_name, phase: :send_metadata_request
  |> reason_rule pred: "packet_observed:tcp:remote:kafka:remote_to_local", event: :packet_observed, narr: $metadata_narrative, dedupe: true, mod: $module_name, phase: :receive_metadata_response

template :kafka_metadata_path
|> window :default_5s
|> use :kafka_metadata_rules
