# gewyvern stable-subset protocol path

fn dns_error_rules() =
  let module_name = :dns_error_path
  let error_narrative = "static:observed a DNS error response code from the resolver path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:dns_error)
  |> reason_model(:dns_error_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:53:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x01", stage: :datagram_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_formerr)
  |> program_rule(predicate: "datagram_observed:udp:remote:53:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x02", stage: :datagram_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_servfail)
  |> program_rule(predicate: "datagram_observed:udp:remote:53:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x03", stage: :datagram_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_nxdomain)
  |> program_rule(predicate: "datagram_observed:udp:remote:53:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x05", stage: :datagram_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_refused)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)

template(:dns_error_path)
|> window(:default_5s)
|> use(:dns_error_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
