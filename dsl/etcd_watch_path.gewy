# gewyvern stable-subset protocol path

fn etcd_watch_rules() =
  let module_name = :etcd_watch_path
  let watch_narrative = "static:observed an etcd watch stream request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :etcd_watch
  |> reason_model :etcd_watch_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_member
  |> program_rule pred: "packet_observed:tcp:remote:https:local_to_remote", stage: :packet_observed, narr: $watch_narrative, dedupe: true, mod: $module_name, phase: :open_watch
  |> program_rule pred: "packet_observed:tcp:remote:https:remote_to_local", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :watch_event
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_member
  |> reason_rule pred: "packet_observed:tcp:remote:https:local_to_remote", event: :packet_observed, narr: $watch_narrative, dedupe: true, mod: $module_name, phase: :open_watch
  |> reason_rule pred: "packet_observed:tcp:remote:https:remote_to_local", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :watch_event

template :etcd_watch_path
|> window :default_5s
|> use :etcd_watch_rules
|> param :sock_lineage_fragment.capture_comm, true
