# gewyvern stable-subset protocol path

fn ssdp_discovery_rules() =
  let module_name = :ssdp_discovery_path
  let route_narrative = "static:program resolved a multicast route for this SSDP discovery path"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :ssdp_discovery
  |> reason_model :ssdp_discovery_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "datagram_observed:udp:local:ssdp:remote:ssdp:local_to_remote:prefix4:0x4d2d5345", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_search
  |> program_rule pred: "datagram_observed:udp:local:ssdp:remote:ssdp:remote_to_local:prefix4:0x48545450", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "datagram_observed:udp:local:ssdp:remote:ssdp:local_to_remote:prefix4:0x4d2d5345", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_search
  |> reason_rule pred: "datagram_observed:udp:local:ssdp:remote:ssdp:remote_to_local:prefix4:0x48545450", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response

template :ssdp_discovery_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :ssdp_discovery_rules
|> param :sock_lineage_fragment.capture_comm, true
