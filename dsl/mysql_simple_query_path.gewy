# gewyvern DSL v0
template=mysql_simple_query_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=mysql_simple_query_path_reason
fragment=tcp_state_fragment
fragment=tcp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=mysql_simple_query
rule=process_bound;process_bound;process_bound;true;mysql_simple_query_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this MySQL query path;true;mysql_simple_query_path;resolve_upstream
rule=socket_state_observed:remote:mysql;socket_state_transition;static:program initiated or advanced a MySQL socket state transition;false;mysql_simple_query_path;connect
rule=socket_state_observed:remote:mysql:established;socket_state_transition;static:program reached an established MySQL socket state;true;mysql_simple_query_path;establish
rule=packet_observed:tcp:remote:mysql:local_to_remote:byte_at:4:0xff:0x03;packet_observed;transport_payload_sent;true;mysql_simple_query_path;send_query
rule=packet_observed:tcp:remote:mysql:remote_to_local:byte_at:4:0xff:0x00;packet_observed;transport_payload_received;true;mysql_simple_query_path;receive_ok
reason.rule=process_bound;process_identified;process_bound;true;mysql_simple_query_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;mysql_simple_query_path;resolve_upstream
reason.rule=socket_state_observed:remote:mysql;state_change;tcp_state_transition;false;mysql_simple_query_path;connect
reason.rule=socket_state_observed:remote:mysql:established;state_change;tcp_state_transition;true;mysql_simple_query_path;establish
reason.rule=packet_observed:tcp:remote:mysql:local_to_remote:byte_at:4:0xff:0x03;packet_observed;transport_payload_sent;true;mysql_simple_query_path;send_query
reason.rule=packet_observed:tcp:remote:mysql:remote_to_local:byte_at:4:0xff:0x00;packet_observed;transport_payload_received;true;mysql_simple_query_path;receive_ok
param=sock_lineage_fragment.capture_comm=true
