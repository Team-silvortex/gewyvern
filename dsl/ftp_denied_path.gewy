# gewyvern stable-subset protocol path

fn ftp_denied_rules() =
  let module_name = :ftp_denied_path
  let route_narrative = "static:program resolved an upstream route for this FTP denied path"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:ftp_denied)
  |> reason_model(:ftp_denied_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "socket_state_observed:remote:ftp", stage: :socket_state_transition, narrative: "static:program initiated or advanced an FTP socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_user)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_password_required)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_pass)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x35333020", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_denied)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "socket_state_observed:remote:ftp", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_user)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_password_required)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_pass)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x35333020", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_denied)

template(:ftp_denied_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:ftp_denied_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
