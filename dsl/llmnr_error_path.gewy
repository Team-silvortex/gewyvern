# gewyvern stable-subset protocol path

fn llmnr_error_rules() =
  let module_name = :llmnr_error_path
  let error_narrative = "static:observed an LLMNR local-link resolver error response"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :llmnr_error
  |> reason_model :llmnr_error_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_local_link
  |> program_rule pred: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x01", stage: :datagram_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_formerr
  |> program_rule pred: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x02", stage: :datagram_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_servfail
  |> program_rule pred: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80:byte_at:3:0x0f:0x03", stage: :datagram_observed, narr: $error_narrative, dedupe: true, mod: $module_name, phase: :receive_nxdomain
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_local_link

template :llmnr_error_path
|> window :default_5s
|> use :llmnr_error_rules
|> param :sock_lineage_fragment.capture_comm, true
