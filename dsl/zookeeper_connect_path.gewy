# gewyvern stable-subset protocol path

fn zookeeper_connect_rules() =
  let module_name = :zookeeper_connect_path
  let narrative = "static:observed a ZooKeeper session connect exchange"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:zookeeper_connect)
  |> reason_model(:zookeeper_connect_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_ensemble)
  |> program_rule(predicate: "packet_observed:tcp:remote:2181:local_to_remote", stage: :packet_observed, narrative: ${narrative}, dedupe: true, module: ${module_name}, phase: :send_connect)
  |> program_rule(predicate: "packet_observed:tcp:remote:2181:remote_to_local", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_connect)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_ensemble)
  |> reason_rule(predicate: "packet_observed:tcp:remote:2181:local_to_remote", key_event: :packet_observed, narrative: ${narrative}, dedupe: true, module: ${module_name}, phase: :send_connect)
  |> reason_rule(predicate: "packet_observed:tcp:remote:2181:remote_to_local", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_connect)

template(:zookeeper_connect_path)
|> window(:default_5s)
|> use(:zookeeper_connect_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
