# gewyvern DSL v0
template=socks5_session_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=socks5_session_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=socks5_session
rule=process_bound;process_bound;process_bound;true;socks5_session_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this SOCKS5 session;true;socks5_session_path;resolve_upstream
rule=socket_state_observed:remote:socks5;socket_state_transition;static:program initiated or advanced a SOCKS5 socket state transition;false;socks5_session_path;connect
rule=packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01;packet_observed;transport_payload_sent;true;socks5_session_path;send_method_greeting
rule=packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00;packet_observed;transport_payload_received;true;socks5_session_path;receive_method_selection
rule=packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01,0x00,0x03;packet_observed;transport_payload_sent;true;socks5_session_path;send_connect_request
rule=packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00,0x00,0x01;packet_observed;transport_payload_received;true;socks5_session_path;receive_connect_success
reason.rule=process_bound;process_identified;process_bound;true;socks5_session_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;socks5_session_path;resolve_upstream
reason.rule=socket_state_observed:remote:socks5;state_change;tcp_state_transition;false;socks5_session_path;connect
reason.rule=packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01;packet_observed;transport_payload_sent;true;socks5_session_path;send_method_greeting
reason.rule=packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00;packet_observed;transport_payload_received;true;socks5_session_path;receive_method_selection
reason.rule=packet_observed:tcp:remote:socks5:local_to_remote:bytes_at:0:0x05,0x01,0x00,0x03;packet_observed;transport_payload_sent;true;socks5_session_path;send_connect_request
reason.rule=packet_observed:tcp:remote:socks5:remote_to_local:bytes_at:0:0x05,0x00,0x00,0x01;packet_observed;transport_payload_received;true;socks5_session_path;receive_connect_success
param=sock_lineage_fragment.capture_comm=true
