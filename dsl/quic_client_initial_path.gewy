# gewyvern DSL v0
template=quic_client_initial_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=quic_client_initial_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=quic_client_initial
rule=process_bound;process_bound;process_bound;true;quic_client_initial_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this QUIC client path;true;quic_client_initial_path;resolve_upstream
rule=quic_packet_observed:remote:quic:local_to_remote:min_len:1200:long_header:true:type:initial;datagram_observed;udp_datagram_sent;true;quic_client_initial_path;send_initial
rule=quic_packet_observed:remote:quic:remote_to_local:long_header:true:type:handshake;datagram_observed;udp_datagram_received;true;quic_client_initial_path;receive_handshake
reason.rule=process_bound;process_identified;process_bound;true;quic_client_initial_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;quic_client_initial_path;resolve_upstream
reason.rule=quic_packet_observed:remote:quic:local_to_remote:min_len:1200:long_header:true:type:initial;udp_datagram_seen;udp_datagram_sent;true;quic_client_initial_path;send_initial
reason.rule=quic_packet_observed:remote:quic:remote_to_local:long_header:true:type:handshake;udp_datagram_seen;udp_datagram_received;true;quic_client_initial_path;receive_handshake
param=sock_lineage_fragment.capture_comm=true
