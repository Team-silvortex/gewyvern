template=wireguard_handshake_path
window=default_5s
reason=udp_datagram_l1
reason_model=wireguard_handshake_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=wireguard_handshake_path_model
operation=wireguard_handshake
rule=process_bound;process_bound;process_bound;true;wireguard_handshake_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this WireGuard handshake path;true;wireguard_handshake_path;resolve_upstream
rule=datagram_observed:udp:remote:wireguard:local_to_remote:byte0_mask:0xff:0x01;datagram_observed;udp_datagram_sent;true;wireguard_handshake_path;send_initiation
rule=datagram_observed:udp:remote:wireguard:remote_to_local:byte0_mask:0xff:0x02;datagram_observed;udp_datagram_received;true;wireguard_handshake_path;receive_response
reason.rule=process_bound;process_identified;process_bound;true;wireguard_handshake_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;wireguard_handshake_path;resolve_upstream
reason.rule=datagram_observed:udp:remote:wireguard:local_to_remote:byte0_mask:0xff:0x01;udp_datagram_seen;udp_datagram_sent;true;wireguard_handshake_path;send_initiation
reason.rule=datagram_observed:udp:remote:wireguard:remote_to_local:byte0_mask:0xff:0x02;udp_datagram_seen;udp_datagram_received;true;wireguard_handshake_path;receive_response
