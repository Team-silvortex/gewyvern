fn quic_local_close_rules() =
  let module_name = :quic_local_close_path
  |> fragment :udp_packet_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :quic_local_close_observation
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "quic_packet_observed:local:quic:remote_to_local:min_len:1200:long_header:true:type:initial", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_initial
  |> program_rule pred: "quic_frame_observed:local:quic:remote_to_local:type:initial:frame:crypto", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_crypto
  |> program_rule pred: "quic_packet_observed:local:quic:local_to_remote:long_header:true:type:handshake", stage: :datagram_observed, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_handshake
  |> program_rule pred: "quic_frame_observed:local:quic:local_to_remote:type:handshake:frame:crypto", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_crypto
  |> program_rule pred: "quic_frame_observed:local:quic:local_to_remote:frame:connection_close", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_close
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "quic_packet_observed:local:quic:remote_to_local:min_len:1200:long_header:true:type:initial", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_initial
  |> reason_rule pred: "quic_frame_observed:local:quic:remote_to_local:type:initial:frame:crypto", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_crypto
  |> reason_rule pred: "quic_packet_observed:local:quic:local_to_remote:long_header:true:type:handshake", event: :udp_datagram_seen, narr: :udp_datagram_sent, dedupe: true, mod: $module_name, phase: :send_handshake
  |> reason_rule pred: "quic_frame_observed:local:quic:local_to_remote:type:handshake:frame:crypto", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_crypto
  |> reason_rule pred: "quic_frame_observed:local:quic:local_to_remote:frame:connection_close", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_close

template :quic_local_close_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :quic_local_close_rules
