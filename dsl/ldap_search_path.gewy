fn ldap_search_rules() =
  let module_name = :ldap_search_path
  let route_narrative = "static:program resolved an upstream route for this LDAP search path"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> program_model :ldap_search_path_model
  |> operation :ldap_search
  |> reason_model :ldap_search_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: "socket_state_observed:remote:ldap", stage: :socket_state_transition, narr: "static:program initiated or advanced an LDAP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:ldap:established", stage: :socket_state_transition, narr: "static:program reached an established LDAP socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x63", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_search
  |> program_rule pred: "packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x65", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_search_result
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: "socket_state_observed:remote:ldap", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:ldap:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "packet_observed:tcp:remote:ldap:local_to_remote:byte_at:5:0xff:0x63", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_search
  |> reason_rule pred: "packet_observed:tcp:remote:ldap:remote_to_local:byte_at:5:0xff:0x65", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_search_result

template :ldap_search_path
|> window :default_5s
|> use :ldap_search_rules
