# gewyvern stable-subset protocol path

fn llmnr_response_rules() =
  let module_name = :llmnr_response_path
  let route_narrative = "static:program resolved a local-link route for this LLMNR response"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:llmnr_response)
  |> reason_model(:llmnr_response_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_local_link)
  |> program_rule(predicate: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_local_link)
  |> reason_rule(predicate: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_response)

template(:llmnr_response_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:llmnr_response_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
