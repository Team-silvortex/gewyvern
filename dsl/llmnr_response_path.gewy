# gewyvern stable-subset protocol path

fn llmnr_response_rules() =
  let module_name = :llmnr_response_path
  let route_narrative = "static:program resolved a local-link route for this LLMNR response"
  |> fragment :udp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :llmnr_response
  |> reason_model :llmnr_response_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_local_link
  |> program_rule pred: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80", stage: :datagram_observed, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_local_link
  |> reason_rule pred: "datagram_observed:udp:remote:llmnr:remote_to_local:byte_at:2:0x80:0x80", event: :udp_datagram_seen, narr: :udp_datagram_received, dedupe: true, mod: $module_name, phase: :receive_response

template :llmnr_response_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :llmnr_response_rules
|> param :sock_lineage_fragment.capture_comm, true
