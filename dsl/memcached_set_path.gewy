# gewyvern stable-subset protocol path

fn memcached_set_rules() =
  let module_name = :memcached_set_path
  let route_narrative = "static:program resolved an upstream route for this Memcached SET path"
  |> fragment :tcp_state_fragment
  |> fragment :tcp_packet_meta_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :memcached_set
  |> reason_model :memcached_set_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:memcached", stage: :socket_state_transition, narr: "static:program initiated or advanced a Memcached socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "socket_state_observed:remote:memcached:established", stage: :socket_state_transition, narr: "static:program reached an established Memcached socket state", dedupe: true, mod: $module_name, phase: :establish
  |> program_rule pred: "packet_observed:tcp:remote:memcached:local_to_remote:byte0_mask:0xff:0x80:byte_at:1:0xff:0x01", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_set
  |> program_rule pred: "packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x01", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_stored
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:memcached", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "socket_state_observed:remote:memcached:established", event: :state_change, narr: :tcp_state_transition, dedupe: true, mod: $module_name, phase: :establish
  |> reason_rule pred: "packet_observed:tcp:remote:memcached:local_to_remote:byte0_mask:0xff:0x80:byte_at:1:0xff:0x01", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_set
  |> reason_rule pred: "packet_observed:tcp:remote:memcached:remote_to_local:byte0_mask:0xff:0x81:byte_at:1:0xff:0x01", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_stored

template :memcached_set_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :memcached_set_rules
|> param :sock_lineage_fragment.capture_comm, true
