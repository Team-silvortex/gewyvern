# gewyvern stable-subset protocol path

fn vxlan_encap_rules() =
  let module_name = :vxlan_encap_path
  let encap_narrative = "static:observed a VXLAN overlay packet on UDP port 4789"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> operation(:vxlan_encap)
  |> reason_model(:vxlan_encap_path_reason)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_overlay)
  |> program_rule(predicate: "datagram_observed:udp:remote:vxlan:local_to_remote", stage: :datagram_observed, narrative: ${encap_narrative}, dedupe: true, module: ${module_name}, phase: :send_overlay_packet)
  |> program_rule(predicate: "datagram_observed:udp:remote:vxlan:remote_to_local", stage: :datagram_observed, narrative: ${encap_narrative}, dedupe: true, module: ${module_name}, phase: :receive_overlay_packet)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_overlay)
  |> reason_rule(predicate: "datagram_observed:udp:remote:vxlan:local_to_remote", key_event: :udp_datagram_seen, narrative: ${encap_narrative}, dedupe: true, module: ${module_name}, phase: :send_overlay_packet)
  |> reason_rule(predicate: "datagram_observed:udp:remote:vxlan:remote_to_local", key_event: :udp_datagram_seen, narrative: ${encap_narrative}, dedupe: true, module: ${module_name}, phase: :receive_overlay_packet)

template(:vxlan_encap_path)
|> window(:default_5s)
|> use(:vxlan_encap_rules)
