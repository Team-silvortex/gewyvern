# gewyvern stable-subset protocol path

fn snmp_unauthorized_rules() =
  let module_name = :snmp_unauthorized_path
  let route_narrative = "static:program resolved an SNMP route that returned an authorization failure report"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:snmp_unauthorized)
  |> reason_model(:snmp_unauthorized_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa8:byte_at:18:0xff:0x05", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_authorization_failure_report)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:snmp:remote_to_local:byte_at:4:0xff:0x03:byte_at:13:0xff:0xa8:byte_at:18:0xff:0x05", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_authorization_failure_report)

template(:snmp_unauthorized_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:snmp_unauthorized_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
