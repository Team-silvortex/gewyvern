# gewyvern stable-subset protocol path

fn mongodb_legacy_query_rules() =
  let module_name = :mongodb_legacy_query_path
  let query_narrative = "static:observed a legacy MongoDB OP_QUERY request"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :mongodb_legacy_query
  |> reason_model :mongodb_legacy_query_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_server
  |> program_rule pred: "packet_observed:tcp:remote:27017:local_to_remote:bytes_at:12:0xd4,0x07,0x00,0x00", stage: :packet_observed, narr: $query_narrative, dedupe: true, mod: $module_name, phase: :send_op_query
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_server
  |> reason_rule pred: "packet_observed:tcp:remote:27017:local_to_remote:bytes_at:12:0xd4,0x07,0x00,0x00", event: :packet_observed, narr: $query_narrative, dedupe: true, mod: $module_name, phase: :send_op_query

template :mongodb_legacy_query_path
|> window :default_5s
|> use :mongodb_legacy_query_rules
|> param :sock_lineage_fragment.capture_comm, true
