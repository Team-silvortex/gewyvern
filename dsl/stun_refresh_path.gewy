# gewyvern stable-subset protocol path

fn stun_refresh_rules() =
  let module_name = :stun_refresh_path
  let route_narrative = "static:program resolved an upstream route for this STUN refresh path"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:stun_refresh)
  |> reason_model(:stun_refresh_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0004", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_refresh_request)
  |> program_rule(predicate: "datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0104", stage: :datagram_observed, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_refresh_response)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:stun:local_to_remote:prefix2:0x0004", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_refresh_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote:stun:remote_to_local:prefix2:0x0104", key_event: :udp_datagram_seen, narrative: :udp_datagram_received, dedupe: true, module: ${module_name}, phase: :receive_refresh_response)

template(:stun_refresh_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:stun_refresh_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
