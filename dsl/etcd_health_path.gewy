# gewyvern stable-subset protocol path

fn etcd_health_rules() =
  let module_name = :etcd_health_path
  let http_health = "static:observed an etcd HTTP health probe"
  let grpc_status = "static:observed an etcd maintenance status probe"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:etcd_health)
  |> reason_model(:etcd_health_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_member)
  |> program_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", stage: :packet_observed, narrative: ${http_health}, dedupe: true, module: ${module_name}, phase: :send_health)
  |> program_rule(predicate: "packet_observed:tcp:remote:https:local_to_remote", stage: :packet_observed, narrative: ${grpc_status}, dedupe: true, module: ${module_name}, phase: :send_status)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_member)
  |> reason_rule(predicate: "packet_observed:tcp:remote:http:local_to_remote:prefix4:0x47455420", key_event: :packet_observed, narrative: ${http_health}, dedupe: true, module: ${module_name}, phase: :send_health)
  |> reason_rule(predicate: "packet_observed:tcp:remote:https:local_to_remote", key_event: :packet_observed, narrative: ${grpc_status}, dedupe: true, module: ${module_name}, phase: :send_status)

template(:etcd_health_path)
|> window(:default_5s)
|> use(:etcd_health_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
