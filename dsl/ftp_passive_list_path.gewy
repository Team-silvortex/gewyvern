# gewyvern stable-subset protocol path

fn ftp_passive_list_rules() =
  let module_name = :ftp_passive_list_path
  let route_narrative = "static:program resolved an upstream route for this FTP passive list session"
  |> fragment(:tcp_packet_meta_fragment)
  |> fragment(:tcp_state_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:ftp_passive_list)
  |> reason_model(:ftp_passive_list_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "socket_state_observed:remote:ftp", stage: :socket_state_transition, narrative: "static:program initiated or advanced an FTP socket state transition", dedupe: false, module: ${module_name}, phase: :connect)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_user)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_password_required)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_pass)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32333020", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_ok)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415356", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_pasv)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323720", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_pasv_ready)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x4c495354", stage: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_list)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x31353020", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_transfer_open)
  |> program_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323620", stage: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_transfer_complete)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "socket_state_observed:remote:ftp", key_event: :state_change, narrative: :tcp_state_transition, dedupe: false, module: ${module_name}, phase: :connect)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323020", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_banner)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x55534552", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_user)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x33333120", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_password_required)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415353", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_auth_pass)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32333020", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_auth_ok)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x50415356", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_pasv)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323720", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_pasv_ready)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:local_to_remote:prefix4:0x4c495354", key_event: :packet_observed, narrative: :transport_payload_sent, dedupe: true, module: ${module_name}, phase: :send_list)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x31353020", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_transfer_open)
  |> reason_rule(predicate: "packet_observed:tcp:remote:ftp:remote_to_local:prefix4:0x32323620", key_event: :packet_observed, narrative: :transport_payload_received, dedupe: true, module: ${module_name}, phase: :receive_transfer_complete)

template(:ftp_passive_list_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:ftp_passive_list_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
