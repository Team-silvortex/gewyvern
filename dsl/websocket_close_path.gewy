# gewyvern stable-subset protocol path

fn websocket_close_rules() =
  let module_name = :websocket_close_path
  let close_narrative = "static:observed a WebSocket close control frame on an established TCP stream"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :websocket_close
  |> reason_model :websocket_close_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: :route_resolved, dedupe: true, mod: $module_name, phase: :resolve_endpoint
  |> program_rule pred: "packet_observed:tcp:local_to_remote:byte_at:0:0x0f:0x08", stage: :packet_observed, narr: $close_narrative, dedupe: true, mod: $module_name, phase: :send_close
  |> program_rule pred: "packet_observed:tcp:remote_to_local:byte_at:0:0x0f:0x08", stage: :packet_observed, narr: $close_narrative, dedupe: true, mod: $module_name, phase: :receive_close
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_endpoint
  |> reason_rule pred: "packet_observed:tcp:local_to_remote:byte_at:0:0x0f:0x08", event: :packet_observed, narr: $close_narrative, dedupe: true, mod: $module_name, phase: :send_close
  |> reason_rule pred: "packet_observed:tcp:remote_to_local:byte_at:0:0x0f:0x08", event: :packet_observed, narr: $close_narrative, dedupe: true, mod: $module_name, phase: :receive_close

template :websocket_close_path
|> window :default_5s
|> use :websocket_close_rules
|> param :sock_lineage_fragment.capture_comm, true
