# gewyvern DSL v0
template=ssh_session_path
window.duration_ms=5000
window.lateness_ms=200
reason_model=ssh_session_path_reason
fragment=tcp_packet_meta_fragment
fragment=tcp_state_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
operation=ssh_session
rule=process_bound;process_bound;process_bound;true;ssh_session_path;bind
rule=route_resolved;route_resolved;static:program resolved an upstream route for this SSH session;true;ssh_session_path;resolve_upstream
rule=socket_state_observed:remote:ssh;socket_state_transition;static:program initiated or advanced an SSH socket state transition;false;ssh_session_path;connect
rule=packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d;packet_observed;transport_payload_received;true;ssh_session_path;receive_server_banner
rule=packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d;packet_observed;transport_payload_sent;true;ssh_session_path;send_client_banner
rule=packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14;packet_observed;transport_payload_sent;true;ssh_session_path;send_key_exchange_init
reason.rule=process_bound;process_identified;process_bound;true;ssh_session_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;ssh_session_path;resolve_upstream
reason.rule=socket_state_observed:remote:ssh;state_change;tcp_state_transition;false;ssh_session_path;connect
reason.rule=packet_observed:tcp:remote:ssh:remote_to_local:prefix4:0x5353482d;packet_observed;transport_payload_received;true;ssh_session_path;receive_server_banner
reason.rule=packet_observed:tcp:remote:ssh:local_to_remote:prefix4:0x5353482d;packet_observed;transport_payload_sent;true;ssh_session_path;send_client_banner
reason.rule=packet_observed:tcp:remote:ssh:local_to_remote:byte_at:5:0xff:0x14;packet_observed;transport_payload_sent;true;ssh_session_path;send_key_exchange_init
param=sock_lineage_fragment.capture_comm=true
