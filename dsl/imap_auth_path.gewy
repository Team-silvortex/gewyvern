# gewyvern stable-subset protocol path

fn imap_auth_rules() =
  let module_name = :imap_auth_path
  let route_narrative = "static:program resolved an upstream route for this IMAP auth session"
  |> fragment :tcp_packet_meta_fragment
  |> fragment :tcp_state_fragment
  |> fragment :route_meta_fragment
  |> fragment :sock_lineage_fragment
  |> operation :imap_auth
  |> reason_model :imap_auth_path_reason
  |> program_rule pred: :process_bound, stage: :process_bound, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> program_rule pred: :route_resolved, stage: :route_resolved, narr: $route_narrative, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> program_rule pred: "socket_state_observed:remote:imap", stage: :socket_state_transition, narr: "static:program initiated or advanced an IMAP socket state transition", dedupe: false, mod: $module_name, phase: :connect
  |> program_rule pred: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x2a204f4b", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_banner
  |> program_rule pred: "packet_observed:tcp:remote:imap:local_to_remote:prefix4:0x41303031:bytes_at:5:0x4c,0x4f,0x47,0x49,0x4e", stage: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> program_rule pred: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x41303031:bytes_at:5:0x4f,0x4b", stage: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok
  |> reason_rule pred: :process_bound, event: :process_identified, narr: :process_bound, dedupe: true, mod: $module_name, phase: :bind
  |> reason_rule pred: :route_resolved, event: :route_changed, narr: :route_changed, dedupe: true, mod: $module_name, phase: :resolve_upstream
  |> reason_rule pred: "socket_state_observed:remote:imap", event: :state_change, narr: :tcp_state_transition, dedupe: false, mod: $module_name, phase: :connect
  |> reason_rule pred: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x2a204f4b", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_banner
  |> reason_rule pred: "packet_observed:tcp:remote:imap:local_to_remote:prefix4:0x41303031:bytes_at:5:0x4c,0x4f,0x47,0x49,0x4e", event: :packet_observed, narr: :transport_payload_sent, dedupe: true, mod: $module_name, phase: :send_auth_request
  |> reason_rule pred: "packet_observed:tcp:remote:imap:remote_to_local:prefix4:0x41303031:bytes_at:5:0x4f,0x4b", event: :packet_observed, narr: :transport_payload_received, dedupe: true, mod: $module_name, phase: :receive_auth_ok

template :imap_auth_path
|> window(duration_ms: 5000, lateness_ms: 200)
|> use :imap_auth_rules
|> param :sock_lineage_fragment.capture_comm, true
