template=mdns_query_path
window=default_5s
reason=udp_datagram_l1
reason_model=mdns_query_path_reason
fragment=udp_packet_meta_fragment
fragment=route_meta_fragment
fragment=sock_lineage_fragment
program_model=mdns_query_path_model
operation=mdns_query
rule=process_bound;process_bound;process_bound;true;mdns_query_path;bind
rule=route_resolved;route_resolved;static:program resolved a local multicast route for this mDNS path;true;mdns_query_path;resolve_upstream
rule=datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000;datagram_observed;udp_datagram_sent;true;mdns_query_path;send_query
rule=datagram_observed:udp:local:mdns:remote:mdns:remote_to_local:prefix4:0x00008400;datagram_observed;udp_datagram_received;true;mdns_query_path;receive_response
reason.rule=process_bound;process_identified;process_bound;true;mdns_query_path;bind
reason.rule=route_resolved;route_changed;route_changed;true;mdns_query_path;resolve_upstream
reason.rule=datagram_observed:udp:local:mdns:remote:mdns:local_to_remote:prefix4:0x00000000;udp_datagram_seen;udp_datagram_sent;true;mdns_query_path;send_query
reason.rule=datagram_observed:udp:local:mdns:remote:mdns:remote_to_local:prefix4:0x00008400;udp_datagram_seen;udp_datagram_received;true;mdns_query_path;receive_response
