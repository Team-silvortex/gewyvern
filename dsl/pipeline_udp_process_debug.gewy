template(:pipeline_udp_process_debug)
|> window(duration_ms: 5000, lateness_ms: 200)
|> reason(:udp_datagram_l1)
|> fragment(:udp_packet_meta_fragment)
|> fragment(:route_meta_fragment)
|> fragment(:sock_lineage_fragment)
|> operation(:datagram_exchange)
|> program_model(:pipeline_udp_process_debug_model)
|> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: :pipeline_udp_process_debug, phase: :bind)
|> program_rule(predicate: "datagram_observed:udp", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: :pipeline_udp_process_debug, phase: :send_request)
|> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: "static:program resolved a route for this network flow", dedupe: true, module: :pipeline_udp_process_debug, phase: :resolve)
|> param(:sock_lineage_fragment.capture_comm, true)
