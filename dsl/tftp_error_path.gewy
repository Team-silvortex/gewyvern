# gewyvern stable-subset protocol path

fn tftp_error_rules() =
  let module_name = :tftp_error_path
  let route_narrative = "static:program resolved an upstream route for this TFTP transfer"
  let error_narrative = "static:observed a TFTP ERROR packet from the peer"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:tftp_error)
  |> reason_model(:tftp_error_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> program_rule(predicate: "datagram_observed:udp:remote:tftp:local_to_remote:prefix2:0x0001", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_read_request)
  |> program_rule(predicate: "datagram_observed:udp:remote:tftp:remote_to_local:prefix2:0x0005", stage: :datagram_observed, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_error)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_upstream)
  |> reason_rule(predicate: "datagram_observed:udp:remote:tftp:local_to_remote:prefix2:0x0001", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_read_request)
  |> reason_rule(predicate: "datagram_observed:udp:remote:tftp:remote_to_local:prefix2:0x0005", key_event: :udp_datagram_seen, narrative: ${error_narrative}, dedupe: true, module: ${module_name}, phase: :receive_error)

template(:tftp_error_path)
|> window(duration_ms: 5000, lateness_ms: 200)
|> use(:tftp_error_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
