# gewyvern stable-subset protocol path

fn rip_unreachable_rules() =
  let module_name = :rip_unreachable_path
  let unreachable_narrative = "static:observed a RIP route update carrying unreachable metric 16"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:rip_unreachable)
  |> reason_model(:rip_unreachable_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: :route_resolved, dedupe: true, module: ${module_name}, phase: :resolve_neighbor)
  |> program_rule(predicate: "datagram_observed:udp:remote:rip:remote_to_local:byte_at:0:0xff:0x02:byte_at:1:0xff:0x02:byte_at:23:0xff:0x10", stage: :datagram_observed, narrative: ${unreachable_narrative}, dedupe: true, module: ${module_name}, phase: :receive_metric16)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_neighbor)
  |> reason_rule(predicate: "datagram_observed:udp:remote:rip:remote_to_local:byte_at:0:0xff:0x02:byte_at:1:0xff:0x02:byte_at:23:0xff:0x10", key_event: :udp_datagram_seen, narrative: ${unreachable_narrative}, dedupe: true, module: ${module_name}, phase: :receive_metric16)

template(:rip_unreachable_path)
|> window(:default_5s)
|> use(:rip_unreachable_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
