# gewyvern stable-subset protocol path

fn rip_request_rules() =
  let module_name = :rip_request_path
  let route_narrative = "static:program resolved a route before sending a RIP route table request"
  |> fragment(:udp_packet_meta_fragment)
  |> fragment(:route_meta_fragment)
  |> fragment(:sock_lineage_fragment)
  |> operation(:rip_request)
  |> reason_model(:rip_request_path_reason)
  |> program_rule(predicate: :process_bound, stage: :process_bound, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> program_rule(predicate: :route_resolved, stage: :route_resolved, narrative: ${route_narrative}, dedupe: true, module: ${module_name}, phase: :resolve_neighbor)
  |> program_rule(predicate: "datagram_observed:udp:remote:rip:local_to_remote:byte_at:0:0xff:0x01:byte_at:1:0xff:0x02", stage: :datagram_observed, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)
  |> reason_rule(predicate: :process_bound, key_event: :process_identified, narrative: :process_bound, dedupe: true, module: ${module_name}, phase: :bind)
  |> reason_rule(predicate: :route_resolved, key_event: :route_changed, narrative: :route_changed, dedupe: true, module: ${module_name}, phase: :resolve_neighbor)
  |> reason_rule(predicate: "datagram_observed:udp:remote:rip:local_to_remote:byte_at:0:0xff:0x01:byte_at:1:0xff:0x02", key_event: :udp_datagram_seen, narrative: :udp_datagram_sent, dedupe: true, module: ${module_name}, phase: :send_request)

template(:rip_request_path)
|> window(:default_5s)
|> use(:rip_request_rules)
|> param(:sock_lineage_fragment.capture_comm, true)
